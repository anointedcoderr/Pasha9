# Pasha9 environment variables. Copy to .env (dev) or .env.production (server).
# Do not commit secrets. Production values are pasted by the operator on the VPS.

# ----- App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Database
DATABASE_URL=postgresql://pasha9:pasha9@localhost:5432/pasha9_dev

# ----- JWT signing keys
# Generate fresh values for production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_in_production
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ----- Uploads
UPLOAD_ROOT=./uploads          # production sets /var/www/pasha9/uploads

# ----- OTP provider
# Allowed values: console (dev logger), noop (no-op fallback), real adapters land in M2
PASHA9_OTP_PROVIDER=console
PASHA9_SMS_API_KEY=
PASHA9_SMS_SENDER_ID=

# ----- Seed credentials (consumed by packages/database/prisma/seed.ts)
# In production these must be set in the shell session before running seed:prod.
SEED_SUPERADMIN_USERNAME=pasha9.admin
SEED_SUPERADMIN_PHONE=01700000001
SEED_SUPERADMIN_PASSWORD=

# ----- Tracking pixels (filled from admin Settings page, not env)
# Left as a reminder. Do not set hardcoded IDs.
