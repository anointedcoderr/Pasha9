# sanjid14 platform environment variables
# Milestone 1 is fully frontend, no env required to run.
# These keys are pre-defined for Milestone 2 and Milestone 3.

# --- Web app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- API (Milestone 2)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sanjid14
JWT_SECRET=replace_me_with_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
PORT=4000

# --- Storage (Milestone 3)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Payment gateway (Milestone 3, depends on client gateway docs)
PAYMENT_GATEWAY_PROVIDER=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
