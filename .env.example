# Pasha9 environment variables. Copy to .env (dev) or .env.production (server).
# Do not commit secrets. Production values are pasted by the operator on the VPS.

# ----- App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Database
DATABASE_URL=postgresql://pasha9:pasha9@localhost:5432/pasha9_dev

# ----- JWT signing keys
# Generate fresh values for production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string_in_production
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# ----- At-rest secret key (REQUIRED in production)
# Encrypts provider API secrets and admin two-factor seeds at rest, and signs
# the two-factor challenge token. If unset it falls back to JWT_SECRET, and if
# that is also unset the challenge token is signed with a public dev constant.
# Set a strong value. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Warning: rotating this makes already-encrypted admin values unreadable.
SECRETS_KEY=
# Optional distinct fallback used by the two-factor challenge token if SECRETS_KEY is unset.
JWT_SECRET=

# ----- Scheduled jobs (REQUIRED for automation)
# Bearer token that authenticates the cron endpoints (cashback, referral maturity,
# lotto rollover, recovery sweep, WinGo tick, tournament tick). The VPS crontab
# calls these on the loopback with this literal value. Without it, unattended
# jobs do nothing. Generate:  openssl rand -hex 32
CRON_SECRET=

# ----- Public base URL (used for payment callback and return URLs)
# Production: https://pasha9.com
PUBLIC_BASE_URL=http://localhost:3000

# ----- Uploads
UPLOAD_ROOT=./uploads          # production sets /var/www/pasha9/uploads

# ----- OTP provider
# Allowed values: console (dev logger), noop (no-op fallback), real adapters land in M2
PASHA9_OTP_PROVIDER=console
PASHA9_SMS_API_KEY=
PASHA9_SMS_SENDER_ID=

# ----- Seed credentials (consumed by packages/database/prisma/seed.ts)
# In production these must be set in the shell session before running seed:prod.
SEED_SUPERADMIN_USERNAME=pasha9.admin
SEED_SUPERADMIN_PHONE=01700000001
SEED_SUPERADMIN_PASSWORD=

# ----- Tracking pixels (filled from admin Settings page, not env)
# Left as a reminder. Do not set hardcoded IDs.

# ----- Firebase (Phone Auth + admin phone push / FCM)
# One Firebase project powers both the Forgot-Password Phone Auth flow and
# the admin phone-push (FCM) feature. Server credentials (service account):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=          # PEM with literal \n escapes; quoted in .env

# ----- Firebase (player MOBILE APP push / FCM)
# A SECOND, different Firebase project: the one the mobile app is built
# against (see mobile/google-services.json). FCM only delivers to devices
# registered under the same project as the sending credentials, so reusing
# the values above fails every mobile push with
# messaging/mismatched-credential. Generate a service account key in that
# project: Firebase console > Project settings > Service accounts >
# Generate new private key.
# If these are left blank, mobile push falls back to Expo delivery, which
# works but is silently dropped by Samsung/Xiaomi/Oppo/Vivo battery managers
# once the app is closed.
FIREBASE_PLAYER_PROJECT_ID=
FIREBASE_PLAYER_CLIENT_EMAIL=
FIREBASE_PLAYER_PRIVATE_KEY=   # PEM with literal \n escapes; quoted in .env
# Public web config (safe to ship to the browser):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin phone push only. The Web Push certificate PUBLIC key from:
#   Firebase Console > Project settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ----- Optional channels (leave blank to disable that channel)
# Browser web push (VAPID) for admins. Generate a keypair with web-push.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Mobile app (Expo) push throughput. Not required for basic delivery.
EXPO_ACCESS_TOKEN=
# Transactional email (SMTP).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
