{
  "expo": {
    "name": "Pasha9",
    "slug": "pasha9",
    "scheme": "pasha9",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pasha9.player"
    },
    "android": {
      "package": "com.pasha9.player",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06120c"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#06120c"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://pasha9.com",
      "eas": {
        "projectId": "13996c0f-e7a6-4168-bba8-04ef13dbd5ca"
      }
    },
    "owner": "pasha9s-team"
  }
}
