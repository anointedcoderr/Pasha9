{
  "expo": {
    "name": "Pasha9",
    "slug": "pasha9",
    "scheme": "pasha9",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06120c"
    },
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pasha9.player"
    },
    "android": {
      "package": "com.pasha9.player",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06120c"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pasha9 needs access to your photos so you can attach a payment screenshot as deposit proof."
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "apiBaseUrl": "https://pasha9.com",
      "router": {},
      "eas": {
        "projectId": "13996c0f-e7a6-4168-bba8-04ef13dbd5ca"
      }
    },
    "owner": "anointedcoder"
  }
}
