{
  "expo": {
    "name": "Pasha9",
    "slug": "pasha9",
    "scheme": "pasha9",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pasha9.player"
    },
    "android": {
      "package": "com.pasha9.player",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pasha9 needs access to your photos so you can attach a payment screenshot as deposit proof."
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "apiBaseUrl": "https://pasha9.com"
    }
  }
}
