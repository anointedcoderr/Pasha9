// Database schema for the sanjid14 platform.
// Used in Milestone 2 with Prisma + PostgreSQL.
// Built by Anointed Coder.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
  super_admin
}

enum UserStatus {
  active
  blocked
  pending
}

enum Lang {
  bn
  en
}

enum TxType {
  deposit
  withdraw
  bonus
  referral
  bet
  win
  adjust
}

enum TxStatus {
  pending
  completed
  failed
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum BonusType {
  first_deposit
  daily
  weekly
  referral
  vip
  invite
}

enum BannerStatus {
  active
  hidden
}

enum GameStatus {
  active
  maintenance
}

enum ProviderStatus {
  active
  maintenance
}

enum ContentStatus {
  active
  hidden
  paused
}

enum TicketStatus {
  open
  pending
  closed
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  email         String?    @unique
  phone         String     @unique
  passwordHash  String
  referralCode  String     @unique
  referredBy    String?
  role          Role       @default(user)
  status        UserStatus @default(active)
  country       String     @default("BD")
  language      Lang       @default(bn)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  wallet        Wallet?
  transactions  Transaction[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  referrerOf    Referral[]      @relation("Referrer")
  referredAs    Referral[]      @relation("Referred")
  userBonuses   UserBonus[]
  supportTickets SupportTicket[]
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role
  status       UserStatus @default(active)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activityLogs ActivityLog[]
}

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Decimal  @default(0)
  bonusBalance  Decimal  @default(0)
  lockedBalance Decimal  @default(0)
  currency      String   @default("BDT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        TxType
  amount      Decimal
  status      TxStatus @default(completed)
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([type])
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal
  method        String
  transactionId String
  proofUrl      String?
  status        RequestStatus @default(pending)
  adminNote     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  @@index([status])
}

model Withdrawal {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal
  method        String
  accountNumber String
  accountName   String
  status        RequestStatus @default(pending)
  adminNote     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  @@index([status])
}

model Referral {
  id              String   @id @default(cuid())
  referrerId      String
  referredUserId  String
  level           Int      @default(1)
  status          ContentStatus @default(active)
  createdAt       DateTime @default(now())

  referrer        User     @relation("Referrer", fields: [referrerId], references: [id])
  referredUser    User     @relation("Referred", fields: [referredUserId], references: [id])
  bonuses         ReferralBonus[]

  @@unique([referrerId, referredUserId])
}

model ReferralBonus {
  id          String   @id @default(cuid())
  referralId  String
  amount      Decimal
  description String?
  createdAt   DateTime @default(now())
  referral    Referral @relation(fields: [referralId], references: [id])
}

model BonusRule {
  id          String        @id @default(cuid())
  name        String
  type        BonusType
  amount      Decimal       @default(0)
  percentage  Decimal       @default(0)
  minDeposit  Decimal       @default(0)
  maxBonus    Decimal       @default(0)
  status      ContentStatus @default(active)
  description String?
  createdAt   DateTime      @default(now())

  userBonuses UserBonus[]
}

model UserBonus {
  id          String   @id @default(cuid())
  userId      String
  bonusRuleId String
  amount      Decimal
  claimedAt   DateTime @default(now())
  expiresAt   DateTime?

  user        User      @relation(fields: [userId], references: [id])
  bonusRule   BonusRule @relation(fields: [bonusRuleId], references: [id])
}

model Banner {
  id        String        @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  link      String?
  accent    String        @default("gold")
  position  Int           @default(0)
  status    BannerStatus  @default(active)
  createdAt DateTime      @default(now())
}

model PopupAnnouncement {
  id        String        @id @default(cuid())
  title     String
  body      String
  ctaLabel  String?
  ctaHref   String?
  startAt   DateTime
  endAt     DateTime
  status    BannerStatus  @default(active)
  createdAt DateTime      @default(now())
}

model PromoText {
  id       String        @id @default(cuid())
  message  String
  position Int           @default(0)
  status   BannerStatus  @default(active)
  createdAt DateTime     @default(now())
}

model GameCategory {
  id      String        @id @default(cuid())
  slug    String        @unique
  nameBn  String
  nameEn  String
  iconKey String
  status  BannerStatus  @default(active)
  games   Game[]
}

model GameProvider {
  id      String          @id @default(cuid())
  name    String          @unique
  apiBase String?
  apiKey  String?
  status  ProviderStatus  @default(active)
  games   Game[]
}

model Game {
  id         String       @id @default(cuid())
  name       String
  nameBn     String?
  categoryId String
  providerId String
  imageUrl   String?
  launchUrl  String?
  accent     String       @default("gold")
  isFeatured Boolean      @default(false)
  status     GameStatus   @default(active)
  minBet     Decimal      @default(10)
  maxBet     Decimal      @default(5000)
  houseEdge  Decimal      @default(3)
  riskLevel  String       @default("medium")
  createdAt  DateTime     @default(now())

  category   GameCategory @relation(fields: [categoryId], references: [id])
  provider   GameProvider @relation(fields: [providerId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  target    String
  detail    String?
  createdAt DateTime @default(now())

  admin     Admin?   @relation(fields: [adminId], references: [id])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String?
  subject   String
  body      String
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user      User?        @relation(fields: [userId], references: [id])
}

model SystemSetting {
  id    String  @id @default(cuid())
  key   String  @unique
  value String
  type  String  @default("string")
}

model PaymentMethod {
  id          String        @id @default(cuid())
  name        String        @unique
  type        String        @default("mobile")
  status      BannerStatus  @default(active)
  number      String
  instruction String
}
