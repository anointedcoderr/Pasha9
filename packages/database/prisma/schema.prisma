// Database schema for the Pasha9 platform.
// Live PostgreSQL schema. Migrations live under prisma/migrations.
// Built by Anointed Coder.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  active
  blocked
  pending
}

enum Lang {
  bn
  en
}

enum TxType {
  deposit
  withdraw
  bonus
  referral
  bet
  win
  adjust
}

enum TxStatus {
  pending
  completed
  failed
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum BonusType {
  first_deposit
  daily
  weekly
  referral
  vip
  invite
  reload
  manual
  promo
}

enum ContentStatus {
  active
  hidden
  paused
}

enum GameStatus {
  active
  maintenance
}

enum ProviderStatus {
  active
  maintenance
}

enum TicketStatus {
  open
  pending
  resolved
  closed
}

enum OtpPurpose {
  signup
  login
  reset
  verify_phone
}

enum SettingCategory {
  general
  branding
  security
  sms
  payment
  apk
  tracking
  content
  referral
  rewards
}

// ---------- Auth and RBAC ----------

model Role {
  id        String   @id @default(cuid())
  key       String   @unique // super_admin, admin, staff, user
  label     String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // banners.write, users.read, etc.
  label     String
  group     String   @default("general") // ui grouping
  createdAt DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// M2G: per-staff additive permission grants. The user's effective
// permission set is union(role.permissions, user.permissions). There
// is no deny flag - if you need to revoke a role-granted permission
// for a specific staff member, move them to a more restricted role
// instead. Created by super_admin / staff.manage holders from the
// /admin/staff page.
model UserPermission {
  userId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model User {
  id                String     @id @default(cuid())
  username          String     @unique
  email             String?    @unique
  phone             String     @unique
  passwordHash      String
  passwordChangedAt DateTime?
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  roleId            String
  status            UserStatus @default(active)
  // Set whenever status flips to blocked, cleared on unblock. Optional
  // free-text shown to the blocked user on the BlockedAccountBanner.
  blockedReason     String?
  blockedAt         DateTime?
  country           String     @default("BD")
  language          Lang       @default(bn)
  // Public avatar URL. Stored as a server-relative /uploads/avatars/...
  // path so the frontend can hot-swap CDN/storage providers without
  // touching DB content. Default null falls back to initials.
  avatarUrl         String?
  referralCode      String     @unique
  referredById      String?
  isAffiliate       Boolean    @default(false)
  affiliateTierId   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  role          Role            @relation(fields: [roleId], references: [id])
  referredBy    User?           @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]          @relation("Referrals")
  affiliateTier CommissionTier? @relation(fields: [affiliateTierId], references: [id])

  wallet                Wallet?
  transactions          Transaction[]
  deposits              Deposit[]
  withdrawals           Withdrawal[]
  userBonuses           UserBonus[]
  supportTickets        SupportTicket[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  activityLogs          ActivityLog[]            @relation("ActorLogs")
  affiliateApplication  AffiliateApplication?
  // VIP Club. vipTierId is set by an admin via /admin/vip when they
  // approve an application or promote a user manually. Null = standard
  // (non-VIP) player.
  vipTierId             String?
  vipTier               VipTier?                 @relation(fields: [vipTierId], references: [id], onDelete: SetNull)
  vipApplications       VipApplication[]
  lotteryTickets        LotteryTicket[]
  lotteryWinnings       LotteryWinning[]
  // M2G per-staff permission grants (additive, beyond role baseline).
  extraPermissions      UserPermission[]
  // M2H recovery tasks where this user is the target (NOT the staff).
  recoveryTasks         RecoveryTask[]           @relation("RecoveryTargetUser")
  // M2K TOTP / 2FA. totpSecret is AES-GCM encrypted by
  // lib/crypto/aead.ts before storage; never returned to the client.
  // recoveryCodesHash is a JSON array of sha256-hashed single-use
  // backup codes - consumed codes are removed in place.
  totpSecret            String?
  totpEnabled           Boolean                  @default(false)
  totpEnrolledAt        DateTime?
  recoveryCodesHash     String?                  @db.Text
  loginAttempts         LoginAttempt[]           @relation("LoginAttemptUser")
  // Pasha Native Games Phase 1: per-user provably-fair sessions across
  // Dice + Mines. Cascade-deletes with the user.
  nativeSessions        GameSession[]
  // M3 Phase 3A: per-provider numeric account map. iGamingAPIs and
  // peer aggregators only accept numeric user_id values; we never
  // expose the internal cuid to upstream and always look up the
  // wallet target through this mapping.
  providerAccounts      ProviderPlayerAccount[]
  // M4 Phase A additive back-relations. Cascade-delete with the user
  // so a permanent user removal sweeps every M4 surface row in one
  // transaction. None of these block any existing flow when empty.
  referralBalance       ReferralBalance?
  referralClaims        ReferralClaim[]
  promotionClaims       PromotionClaim[]
  promoCodeRedemptions  PromoCodeRedemption[]
  notificationsCreated  Notification[]           @relation("NotificationsCreated")
  notificationsReceived NotificationRecipient[]
  pushSubscriptions     PushSubscription[]
  adminPushDevices      AdminPushDevice[]
  campaignsCreated      Campaign[]               @relation("CampaignsCreated")
  campaignRecipients    CampaignRecipient[]
  cashbackPayouts       CashbackPayout[]
  // WinGo tournaments this admin created, and prizes this user won.
  tournamentsCreated    Tournament[]             @relation("TournamentsCreated")
  tournamentPayouts     TournamentPayout[]
  rewardClaims          RewardClaim[]
  dailyCheckIns         DailyCheckInLog[]
  spinResults           SpinResult[]
  wheelSpins            WheelSpin[]
  // Unified bonus redesign: free-spin grants issued to this user from
  // bonus rules, deposit tiers or manual admin actions.
  freeSpinGrants        FreeSpinGrant[]
  bettingPassProgress   UserBettingPassProgress?
  bettingPassEvents     BettingPassEvent[]
  bettingPassClaims     BettingPassClaim[]
  // WinGo colour-prediction native game: every bet this user placed
  // across all four modes. Cascade-deletes with the user so a permanent
  // removal sweeps the player's WinGo history in one transaction. The
  // shared WingoRound rows are never user-owned and are left intact.
  wingoBets             WingoBet[]

  @@index([referredById])
  @@index([roleId])
  @@index([status])
  @@index([isAffiliate])
  // M2J reports: cohort + signup time-series scan this column on
  // every dashboard load. Cheap index, big win.
  @@index([createdAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  ip                String?
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  // Admin-assisted reset workflow. Public submit creates a row with
  // status='pending'. Admin reviews from /admin/password-resets and
  // approves (status='approved') which issues a one-time token that
  // the user redeems via /api/auth/reset-password. status='rejected'
  // closes the request without issuing a token.
  //
  // Firebase Phone Auth reset workflow. When the player completes the
  // Firebase Phone Auth challenge, /api/auth/forgot/phone/verify
  // creates a row with status='approved' (no admin step) and
  // verifiedVia='firebase_phone'. The same /api/auth/reset-password
  // endpoint redeems it.
  status            String    @default("pending") // pending | approved | rejected | consumed
  identifier        String?
  adminNote         String?
  approvedById      String?
  approvedAt        DateTime?
  // Provenance of the approval. 'admin' = legacy admin-approval flow;
  // 'firebase_phone' = self-service Forgot Password via Firebase Phone
  // Auth. Null on pending rows that have not yet been approved.
  verifiedVia       String?
  verifiedPhoneE164 String?
  firebaseUid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([status, createdAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ---------- Wallet, transactions, deposits, withdrawals ----------

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  bonusBalance  Decimal  @default(0) @db.Decimal(14, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(14, 2)
  // Separate ledger for credited lottery winnings. Kept distinct from
  // main balance so audit and (M2) lotto withdrawal flow stay clean.
  lottoBalance  Decimal  @default(0) @db.Decimal(14, 2)
  currency      String   @default("BDT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        TxType
  amount      Decimal  @db.Decimal(14, 2)
  status      TxStatus @default(completed)
  reference   String?
  description String?
  meta        Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id              String        @id @default(cuid())
  userId          String
  amount          Decimal       @db.Decimal(14, 2)
  method          String
  transactionId   String
  // Provider reference + key let an automated webhook (M2B+) match an
  // incoming gateway transaction to a pending Deposit row. Null for
  // the original M1 manual flow.
  providerRef     String?
  providerKey     String?
  proofUrl        String?
  status          RequestStatus @default(pending)
  adminNote       String?
  // M4 Phase C additive: rejectionReason is required when the admin
  // rejects a deposit. Stored separately from adminNote so the
  // freeform admin-only note semantics stay intact. Visible to the
  // player on their deposit history.
  rejectionReason String?
  // Snapshot of the bonus tier that matched at submit time. The
  // actual grant on approval still runs through the bonus engine
  // and may differ if the rule changed between submit and approval.
  // Surfaced on the admin deposits table so reviewers see the
  // promised bonus + total credit at a glance.
  bonusPercentage Decimal?      @db.Decimal(5, 2)
  bonusAmount     Decimal?      @db.Decimal(14, 2)
  // Optional promotion context selected from /promotions. Approval
  // validates the live BonusRule before granting, while these fields
  // preserve the user's original deposit intent for audit.
  promotionRuleId String?
  promotionCode   String?
  reviewerId      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([providerRef])
  @@index([promotionRuleId])
  // M2J: time-series + cohort reports filter by createdAt range.
  @@index([createdAt])
}

model Withdrawal {
  id              String        @id @default(cuid())
  userId          String
  amount          Decimal       @db.Decimal(14, 2)
  method          String
  accountNumber   String
  accountName     String
  status          RequestStatus @default(pending)
  // M2C: sub-state inside an approved row tracking the payout side.
  // Values: 'on_hold' | 'payout_initiated' | 'paid' (null otherwise).
  processingState String?
  // Outbound payout provider + reference once a real payout gateway
  // is wired. Null for M2 manual payouts.
  providerKey     String?
  providerRef     String?
  paidAt          DateTime?
  adminNote       String?
  reviewerId      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user   User              @relation(fields: [userId], references: [id])
  events WithdrawalEvent[]

  @@index([status])
  @@index([userId])
  @@index([providerRef])
  @@index([processingState])
  // M2J: time-series + cohort reports filter by createdAt range.
  @@index([createdAt])
}

// Append-only timeline of every state change on a Withdrawal. Lets
// admin + support see exactly who did what when, and lets the user
// dashboard render a "status timeline" without reverse-engineering
// from ActivityLog.
model WithdrawalEvent {
  id           String   @id @default(cuid())
  withdrawalId String
  kind         String // submitted | reviewed | held | released | approved | payout_initiated | paid | rejected | note
  actorId      String?
  actorRole    String?
  note         String?
  meta         Json?
  createdAt    DateTime @default(now())

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId, createdAt])
  @@index([kind])
}

// ---------- Bonuses ----------

model BonusRule {
  id               String        @id @default(cuid())
  name             String
  nameBn           String?
  type             BonusType
  // Public promotion category selected by admin. Null preserves
  // legacy rows, which are mapped from BonusType at read time.
  promotionType    String?
  amount           Decimal       @default(0) @db.Decimal(14, 2)
  percentage       Decimal       @default(0) @db.Decimal(5, 2)
  minDeposit       Decimal       @default(0) @db.Decimal(14, 2)
  maxBonus         Decimal       @default(0) @db.Decimal(14, 2)
  status           ContentStatus @default(active)
  description      String?
  // Operator-controlled Bengali description + banner image. /promotions
  // renders bannerUrl as a real card image instead of the default
  // gradient placeholder; descriptionBn falls back to description when
  // empty so the EN-only rows still render unchanged.
  descriptionBn    String?       @db.Text
  bannerUrl        String?
  startsAt         DateTime?
  endsAt           DateTime?
  turnoverX        Decimal       @default(0) @db.Decimal(6, 2)
  // M2D: optional stable lookup key so engine code can trigger a
  // rule (e.g. 'welcome', 'deposit_match', 'reload_weekend') without
  // depending on a row id. Unique when set.
  code             String?       @unique
  // Bonus expires N days after grant. 0 = never expires.
  validityDays     Int           @default(30)
  // Higher priority rules win when multiple rules of the same trigger
  // type are eligible for the same deposit.
  priority         Int           @default(0)
  // Per-user claim limit. claimPeriod: unlimited (default, no cap) |
  // account (lifetime) | day | week | month (rolling window). claimLimit
  // is the max grants allowed per period (0 with a non-unlimited period
  // means 1). Enforced in evaluateDepositCandidates and mirrored in the
  // deposit-page eligibility preview. unlimited keeps the legacy
  // "reload fires every deposit" behaviour.
  claimPeriod      String?       @default("unlimited")
  claimLimit       Int           @default(0)
  // Free-form rule config (e.g. weekday filter, vip tier required).
  meta             Json?
  // M4 Phase A additive: promotion presentation assets. All optional.
  // Public /promotions cards and the future /admin/promotions editor
  // bind to these. Leaving them null keeps the existing rule-only
  // behaviour intact.
  bannerDesktopUrl String?
  bannerMobileUrl  String?
  thumbnailUrl     String?
  backgroundUrl    String?
  termsEn          String?       @db.Text
  termsBn          String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  userBonuses       UserBonus[]
  promotionClaims   PromotionClaim[]
  promoCodes        PromoCode[]
  cashbackCampaigns CashbackCampaign[]

  @@index([promotionType, status])
}

model UserBonus {
  id               String    @id @default(cuid())
  userId           String
  // Referral wallet credits use the turnover ledger without requiring
  // an unrelated BonusRule row. Existing bonus grants keep this set.
  bonusRuleId      String?
  amount           Decimal   @db.Decimal(14, 2)
  claimedAt        DateTime  @default(now())
  expiresAt        DateTime?
  // M2D: lifecycle. active = wagering in progress (locked), completed
  // = turnover satisfied + funds released, expired = past expiresAt
  // and forfeited, cancelled = admin cancel.
  status           String    @default("active")
  // Wager requirement captured at grant time. Locked until progress
  // catches up.
  turnoverRequired Decimal   @default(0) @db.Decimal(14, 2)
  turnoverProgress Decimal   @default(0) @db.Decimal(14, 2)
  releasedAt       DateTime?
  cancelledAt      DateTime?
  // Where the grant came from. Lets admin trace a granted bonus back
  // to its trigger (deposit row, manual admin action, referral, etc).
  sourceType       String?
  sourceId         String?
  note             String?

  user           User            @relation(fields: [userId], references: [id])
  bonusRule      BonusRule?      @relation(fields: [bonusRuleId], references: [id])
  turnoverEvents TurnoverEvent[]

  @@index([userId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// M2D: per-event ledger of wager activity that contributed turnover
// to a specific UserBonus grant. Lets the dashboard show the user
// where their progress came from and lets admins audit a grant.
model TurnoverEvent {
  id           String   @id @default(cuid())
  userId       String
  bonusGrantId String?
  amount       Decimal  @db.Decimal(14, 2)
  kind         String // bet|win|adjust|manual
  reference    String?
  meta         Json?
  createdAt    DateTime @default(now())

  bonusGrant UserBonus? @relation(fields: [bonusGrantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([bonusGrantId])
}

// ---------- Editable content (CMS) ----------

model Banner {
  id         String        @id @default(cuid())
  title      String
  subtitle   String?
  titleEn    String?
  subtitleEn String?
  // Media type controls how the public slider renders the slide.
  // "image" (default) renders <img> from imageUrl.
  // "video" renders an autoplay-muted <video> from videoUrl with posterUrl
  // as the still fallback while loading / when autoplay is blocked.
  mediaType  String        @default("image")
  imageUrl   String?
  videoUrl   String?
  posterUrl  String?
  link       String?
  ctaLabel   String?
  accent     String        @default("gold")
  position   Int           @default(0)
  status     ContentStatus @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, position])
}

model PopupAnnouncement {
  id        String        @id @default(cuid())
  title     String
  body      String        @db.Text
  ctaLabel  String?
  ctaHref   String?
  startAt   DateTime?
  endAt     DateTime?
  status    ContentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model PromoText {
  id        String        @id @default(cuid())
  message   String
  position  Int           @default(0)
  status    ContentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, position])
}

model HomepageContent {
  id        String   @id @default(cuid())
  section   String   @unique // hero, about, jackpot, footer, hero_secondary, etc.
  titleBn   String?
  titleEn   String?
  bodyBn    String?  @db.Text
  bodyEn    String?  @db.Text
  imageUrl  String?
  link      String?
  meta      Json?
  updatedAt DateTime @updatedAt
}

// ---------- Games ----------

model GameCategory {
  id           String        @id @default(cuid())
  slug         String        @unique
  nameBn       String
  nameEn       String
  iconKey      String
  // Optional uploaded image used as the category icon. When set the
  // public site prefers this over iconKey, falling back to iconKey if
  // the image fails to load.
  iconImageUrl String?
  position     Int           @default(0)
  status       ContentStatus @default(active)
  games        Game[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// M3 external-provider catalog. Extends the M1 GameProvider with
// everything the iGamingAPIs / SoftAPI adapter needs to operate:
// adapter selection, encrypted secret storage, callback security,
// sync timestamps and per-provider behaviour flags. All new columns
// are nullable / defaulted so `prisma db push` stays additive and
// existing M1 rows keep working.
//
// Secrets (`apiKey`, `apiSecret`, `callbackSecret`) are stored as
// AEAD-encrypted blobs via lib/crypto/aead.ts. They never leave the
// server and are masked in every admin response.
model GameProvider {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  providerKey             String?                 @unique // URL-safe slug used in /api/providers/<key>/*
  adapterKey              String? // 'igamingapis' etc - picks the adapter implementation
  apiBase                 String?
  apiKey                  String? // AEAD-encrypted bearer / API token
  apiSecret               String? // AEAD-encrypted AES-256 secret
  secretEncoding          String?                 @default("utf8") // utf8 | hex | base64
  callbackPath            String? // e.g. /api/providers/igamingapis/callback
  callbackSecret          String? // AEAD-encrypted; matched against ?key= on callback
  ipWhitelist             String? // comma-joined IPs/CIDRs accepted on callback
  clockSkewSeconds        Int                     @default(30)
  currencyCode            String?                 @default("BDT")
  language                String?                 @default("bn")
  callbackResponseMode    String?                 @default("updated_balance") // updated_balance | net_loss_amount
  launchMode              String?                 @default("redirect") // redirect | iframe
  // Optional millisecond offset added to Date.now() inside the
  // launch payload. Default 0. Used only by operators chasing a
  // confirmed clock-drift on the upstream side; the timestamp
  // itself is always generated fresh per launch.
  launchTimestampOffsetMs Int                     @default(0)
  // Public HTTPS base URL the provider must dial to reach our
  // callback / player return endpoints. NULL = fall back to the
  // PUBLIC_SITE_URL env var, then to the incoming request origin
  // (which on a VPS dev session is localhost:3000 - which the
  // provider cannot reach). Set this per-provider as soon as the
  // production domain is final.
  publicBaseUrl           String?
  // Minimum wallet balance (BDT) a player must have before the
  // public launch route will call this provider. 0 disables the
  // pre-check. Used by the lobby to short-circuit to the existing
  // DepositRequiredModal instead of round-tripping a guaranteed
  // failure to upstream.
  launchMinBalance        Decimal                 @default(0) @db.Decimal(14, 2)
  lastSyncAt              DateTime?
  lastHealthCheckAt       DateTime?
  lastHealthCheckOk       Boolean?
  status                  ProviderStatus          @default(maintenance)
  games                   Game[]
  brands                  ProviderBrand[]
  externalGames           ExternalGame[]
  txns                    ProviderTransaction[]
  requestLogs             ProviderRequestLog[]
  callbackLogs            ProviderCallbackLog[]
  playerAccounts          ProviderPlayerAccount[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([adapterKey])
  @@index([status])
}

// One row per brand / sub-provider returned by an aggregator. For
// iGamingAPIs this is e.g. "JILI", "PG Soft" etc.
model ProviderBrand {
  id          String    @id @default(cuid())
  providerId  String
  brandKey    String // provider-side identifier (string per iGamingAPIs)
  displayName String
  status      String    @default("active") // active | hidden
  rawMeta     Json?
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  provider GameProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  games    ExternalGame[]

  @@unique([providerId, brandKey])
  @@index([providerId, status])
}

// One row per playable external game. gameUid is the provider-side
// identifier we send back in the launch payload. category + imageUrl
// drive the public lobby.
model ExternalGame {
  id           String    @id @default(cuid())
  providerId   String
  brandId      String?
  gameUid      String // provider-side identifier echoed in launch + callbacks
  displayName  String
  category     String?
  imageUrl     String?
  status       String    @default("active") // active | hidden | maintenance
  // M3 Phase 3F: featured + sortOrder. Public lobby and homepage
  // rail surface featured rows first; ties broken by sortOrder DESC
  // then displayName ASC. Both default to neutral values so legacy
  // rows render in the same order they did before.
  isFeatured   Boolean   @default(false)
  sortOrder    Int       @default(0)
  // M4 jackpot tagging. Set per row from the admin Games tab or by the
  // auto-tag script (titles containing jackpot / mega / grand /
  // treasure / fortune / crown). Admin can always override.
  isJackpot    Boolean   @default(false)
  jackpotLabel String?
  rawMeta      Json?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  provider GameProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  brand    ProviderBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@unique([providerId, gameUid])
  @@index([providerId, status])
  @@index([brandId])
  @@index([category])
  @@index([isFeatured, sortOrder])
  @@index([isJackpot, sortOrder])
}

// Per-provider numeric member account map. iGamingAPIs and most
// aggregators reject non-numeric user_id values, so we never send
// the internal cuid upstream. memberAccount is an 8-12 digit numeric
// string allocated on first launch and reused forever; the unique
// constraint on (providerId, userId) keeps the mapping stable and
// the unique on (providerId, memberAccount) lets the callback
// resolver translate inbound member_account back to the internal
// User row in O(1).
model ProviderPlayerAccount {
  id            String   @id @default(cuid())
  providerId    String
  userId        String
  memberAccount String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  provider GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, userId])
  @@unique([providerId, memberAccount])
  @@index([userId])
}

// Append-only ledger of every settled provider event. Mirrors the
// M2D Transaction pattern with a unique idempotencyKey so a retried
// provider callback cannot double-settle. walletTransactionId points
// to the corresponding Transaction row written in the same db.$transaction.
model ProviderTransaction {
  id                    String    @id @default(cuid())
  providerId            String
  userId                String?
  memberAccount         String // raw value the provider sent
  gameUid               String?
  gameRound             String
  betAmount             Decimal   @default(0) @db.Decimal(14, 2)
  winAmount             Decimal   @default(0) @db.Decimal(14, 2)
  netResult             Decimal   @default(0) @db.Decimal(14, 2)
  type                  String // bet | win | settle | rollback | rejected
  status                String // accepted | rejected | duplicate | error | rolled_back
  idempotencyKey        String    @unique
  walletTransactionId   String?
  rawRequest            Json?
  rawResponse           Json?
  errorCode             String?
  // M3 Phase 3D: super-admin rollback. Set once when the operator
  // manually reverses a previously-accepted callback. We never call
  // the provider's rollback API (its semantics are unconfirmed) -
  // this is internal wallet correction only.
  rolledBackAt          DateTime?
  rolledBackBy          String? // staff/admin User.id
  rollbackReason        String?
  rollbackTransactionId String? // Transaction.id of the `adjust` row written on rollback
  // M3 Phase 3E: balance snapshots at callback time, taken inside
  // db.$transaction. Lets the admin audit a missing-win incident
  // without re-deriving wallet state from Transaction rows.
  walletBefore          Decimal?  @db.Decimal(14, 2)
  walletAfter           Decimal?  @db.Decimal(14, 2)
  // M3 Phase 3E: super-admin repair. Set when the operator manually
  // credits a missing win on this provider transaction (e.g. when an
  // older idempotency-blocked win is recovered). repairTransactionId
  // is the resulting Transaction(adjust) row; null until repaired.
  repairedAt            DateTime?
  repairedBy            String?
  repairReason          String?
  repairAmount          Decimal?  @db.Decimal(14, 2)
  repairTransactionId   String?
  createdAt             DateTime  @default(now())

  provider GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([userId, createdAt])
  @@index([gameUid])
  @@index([status])
}

// Outbound + inbound HTTP audit. Payloads are masked before storage
// so a stolen DB dump cannot expose tokens, secrets or callback keys.
model ProviderRequestLog {
  id              String   @id @default(cuid())
  providerId      String
  direction       String // outbound | inbound
  endpoint        String
  method          String
  status          Int?
  durationMs      Int?
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime @default(now())

  provider GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
  @@index([direction])
}

// Every callback hit lands here, valid or not. callbackKeyValid /
// ipValid / timestampValid let the operator see why a request was
// rejected without exposing the secret itself.
model ProviderCallbackLog {
  id               String   @id @default(cuid())
  providerId       String
  ip               String?
  method           String   @default("POST")
  callbackKeyValid Boolean?
  ipValid          Boolean?
  timestampValid   Boolean?
  body             Json?
  response         Json?
  processedTxId    String?
  error            String?
  receivedAt       DateTime @default(now())

  provider GameProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, receivedAt])
  @@index([callbackKeyValid])
}

model Game {
  id            String     @id @default(cuid())
  name          String
  nameBn        String?
  categoryId    String
  providerId    String
  imageUrl      String?
  launchUrl     String?
  accent        String     @default("gold")
  isFeatured    Boolean    @default(false)
  status        GameStatus @default(active)
  minBet        Decimal    @default(10) @db.Decimal(14, 2)
  maxBet        Decimal    @default(5000) @db.Decimal(14, 2)
  houseEdge     Decimal    @default(3) @db.Decimal(5, 2)
  rtpTarget     Decimal    @default(95) @db.Decimal(5, 2)
  riskLevel     String     @default("medium")
  wagerContrib  Decimal    @default(100) @db.Decimal(5, 2)
  bonusEligible Boolean    @default(true)
  payoutTable   Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  category GameCategory @relation(fields: [categoryId], references: [id])
  provider GameProvider @relation(fields: [providerId], references: [id])

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
}

// ---------- Referrals ----------
//
// Referral relationships are tracked on the User row via referredById.
// This standalone table is reserved for explicit multi-level snapshots in M2.

model ReferralLink {
  id             String        @id @default(cuid())
  referrerId     String
  referredUserId String
  level          Int           @default(1)
  status         ContentStatus @default(active)
  createdAt      DateTime      @default(now())

  @@unique([referrerId, referredUserId])
  @@index([referrerId])
}

model ReferralBonus {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String
  amount      Decimal  @db.Decimal(14, 2)
  level       Int      @default(1)
  description String?
  createdAt   DateTime @default(now())

  @@index([referrerId])
}

// ---------- Affiliate program (Phase 4) ----------

model AffiliateApplication {
  id         String    @id @default(cuid())
  userId     String    @unique
  status     String    @default("pending") // pending, approved, rejected
  channel    String?
  audience   String?
  notes      String?
  reviewerId String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CommissionTier {
  id                    String        @id @default(cuid())
  name                  String        @unique
  description           String?
  level1Pct             Decimal       @db.Decimal(5, 2)
  level2Pct             Decimal       @db.Decimal(5, 2)
  level3Pct             Decimal       @db.Decimal(5, 2)
  // One-time fixed reward credited to the direct (level 1) upline
  // after the referred user's cumulative approved deposits reach the
  // configured global minimum. Per-tier so
  // VIP tiers can pay a larger signup reward than Bronze. Null = use
  // the global `referral_first_deposit_reward_bdt` SystemSetting,
  // which itself defaults to 0 (disabled). Snapshotted on every
  // AffiliateCommission row via meta.rewardAmount so admin rate
  // changes never rewrite historical payouts.
  firstDepositRewardBdt Decimal?      @db.Decimal(14, 2)
  minActiveReferrals    Int           @default(0)
  minMonthlyVolume      Decimal       @default(0) @db.Decimal(14, 2)
  status                ContentStatus @default(active)
  position              Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  users User[]
}

model AffiliateCommission {
  id             String   @id @default(cuid())
  affiliateId    String
  sourceUserId   String
  level          Int
  amount         Decimal  @db.Decimal(14, 2)
  basis          String // deposit_share, signup_bonus, manual
  status         String   @default("pending") // pending, approved, paid, cancelled
  meta           Json?
  createdAt      DateTime @default(now())
  // M2E additions: trace each commission back to the deposit that
  // triggered it (null for manual / signup grants), the tier and
  // rate used at accrual time so historical reports stay correct
  // even after an admin rebalances the tier rates, and a link to
  // the payout that settled it.
  depositId      String?
  tierId         String?
  ratePct        Decimal? @db.Decimal(5, 2)
  payoutId       String?
  // Stable business key for exact retry protection. Existing rows stay
  // null; new deposit shares and fixed rewards always populate it.
  idempotencyKey String?  @unique

  payout CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  // Dedup guard. Re-running the deposit-approval hook on the same
  // (affiliate, deposit, level, basis) is a no-op - the second insert
  // hits P2002 unique violation which the engine swallows. Distinct
  // bases (deposit_share vs first_deposit_reward) coexist for the
  // same (affiliate, deposit, level=1) so the level-1 upline gets
  // both rows on the referred user's first deposit.
  @@unique([affiliateId, depositId, level, basis])
  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@index([depositId])
  @@index([payoutId])
}

// M2E: an affiliate's request to cash out approved commissions.
// Lifecycle: pending -> approved (admin confirmed, payout in flight)
// -> paid (manual or automated payout cleared) | rejected (admin
// declined with note). On approve, the engine flips every linked
// AffiliateCommission to status=paid and stamps payoutId so the
// commission rows cannot be double-spent into another request.
model CommissionPayout {
  id            String    @id @default(cuid())
  affiliateId   String
  amount        Decimal   @db.Decimal(14, 2)
  method        String // bkash | nagad | rocket | bank
  accountNumber String
  accountName   String
  status        String    @default("pending") // pending | approved | rejected | paid
  adminNote     String?
  reviewerId    String?
  reviewedAt    DateTime?
  paidAt        DateTime?
  providerKey   String? // future payout-provider auto-pay reference
  providerRef   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

// ---------- Lotto draws and reward catalog (Phase 5) ----------

// Banner slot at the top of /lotto. Operator can upload an image or
// an MP4 video and choose a sort order. Multiple active banners
// rotate in a carousel. Video banners default to autoplay + muted +
// loop (which most mobile browsers require to allow autoplay at
// all); the public viewer exposes mute/unmute and play/pause
// controls regardless of the row's defaults.
model LottoBanner {
  id        String   @id @default(cuid())
  kind      String   @default("image") // 'image' | 'video'
  imageUrl  String? // /uploads/banners/...
  videoUrl  String? // /uploads/videos/...
  posterUrl String? // optional video poster image
  titleEn   String?
  titleBn   String?
  ctaUrl    String? // optional click target
  autoplay  Boolean  @default(true)
  muted     Boolean  @default(true)
  loop      Boolean  @default(true)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LottoDraw {
  id          String        @id @default(cuid())
  name        String
  schedule    String? // human readable: "Daily 19:30", "Friday 22:30"
  drawsAt     DateTime? // next draw timestamp
  digitsCount Int           @default(4)
  ticketPrice Decimal       @default(5) @db.Decimal(14, 2)
  prizePool   Decimal       @default(0) @db.Decimal(14, 2)
  accent      String        @default("yellow") // yellow, blue, red, royal
  position    Int           @default(0)
  status      ContentStatus @default(active)
  // M2F: lifecycle markers for the rollover cron. closedAt is set
  // when ticket sales are frozen for this draw (typically the moment
  // the rollover fires - 7:30 PM cutoff). settledAt is set when the
  // result row is published. Both null = still accepting tickets.
  closedAt    DateTime?
  settledAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tickets LotteryTicket[]
  result  LotteryDrawResult?

  @@index([status, position])
}

// Reconciliation log for incoming payment gateway events (M2B). Every
// webhook hit lands here even if the signature is invalid or no
// matching Deposit exists, so support can investigate after the fact.
// Status moves: initiated -> verified -> credited (success) OR
// failed / duplicate / unmatched / signature_invalid.
model PaymentGatewayTx {
  id             String    @id @default(cuid())
  provider       String // manual | test | bkash | nagad | rocket | ...
  // M2C: distinguishes incoming deposit verification (inbound) from
  // outgoing payout status callbacks (outbound). Defaults to inbound
  // so existing M2B rows do not change meaning.
  direction      String    @default("inbound") // inbound | outbound
  providerTxId   String?
  depositId      String?
  withdrawalId   String?
  userId         String?
  amount         Decimal?  @db.Decimal(14, 2)
  currency       String    @default("BDT")
  status         String    @default("initiated")
  signatureValid Boolean   @default(false)
  raw            Json?
  note           String?
  meta           Json?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([provider, providerTxId])
  @@index([depositId])
  @@index([withdrawalId])
  @@index([userId])
  @@index([status])
  @@index([direction, status])
  @@index([receivedAt])
}

// 4D lottery ticket. Generated automatically when admin approves a
// deposit ("source=deposit_accrual") - every accumulated BDT 1,200 of
// approved deposits earns the user 2 tickets. Manual purchase is not
// supported in M1.
model LotteryTicket {
  id              String   @id @default(cuid())
  userId          String
  drawId          String?
  number          String // 4 digits, e.g. "1234"
  source          String   @default("deposit_accrual") // deposit_accrual | admin_grant
  sourceDepositId String?
  status          String   @default("issued") // issued | won | lost | void
  generatedAt     DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw LottoDraw? @relation(fields: [drawId], references: [id])

  @@index([userId])
  @@index([drawId])
  @@index([userId, generatedAt])
}

// Settlement record published by admin per draw. Holds the winning
// number and the prize multipliers applied to that draw. Created
// exactly once per LottoDraw (1:1).
model LotteryDrawResult {
  id               String   @id @default(cuid())
  drawId           String   @unique
  winningNumber    String // 4 digits, e.g. "1234" or "1111"
  ticketBaseValue  Decimal  @default(20) @db.Decimal(14, 2)
  // Prize multipliers per the published structure. Stored on the
  // result so historical draws stay correct even if the live structure
  // changes later.
  prize1xMult      Decimal  @default(2000) @db.Decimal(8, 2)
  prize2xMult      Decimal  @default(800) @db.Decimal(8, 2)
  prize3xMult      Decimal  @default(300) @db.Decimal(8, 2)
  prizeSpecialMult Decimal  @default(150) @db.Decimal(8, 2)
  prizeConsoMult   Decimal  @default(30) @db.Decimal(8, 2)
  publishedById    String?
  publishedAt      DateTime @default(now())
  // Quick aggregates so the public results card is cheap to render.
  totalWinners     Int      @default(0)
  totalPaid        Decimal  @default(0) @db.Decimal(14, 2)
  // M4 Phase F additive: Babu88-style display blob. The settlement
  // engine still derives prizes from `winningNumber` + multipliers,
  // but admins can publish extra prize numbers (2nd, 3rd, special[],
  // consolation[]) here for display. Shape:
  //   { second?: string, third?: string,
  //     specials?: string[], consolations?: string[] }
  // Null when only the canonical winning number was published.
  extraNumbers     Json?
  // The claim mode that took effect for THIS settlement ('auto' |
  // 'manual'). Persisted so late scoring passes (score-orphans)
  // credit winners the same way the original settle did, instead of
  // whatever the global lotto_claim_mode happens to be at that time.
  claimMode        String   @default("auto")

  draw     LottoDraw        @relation(fields: [drawId], references: [id])
  winnings LotteryWinning[]
}

// Per-ticket winning record. Created during settlement for every
// ticket that matched a prize tier. status moves from pending_credit
// to credited when the user's Wallet.lottoBalance is bumped.
// M2F: prizeTier values expanded to first_exact | first_ibox |
// second | third | special | consolation. Each ticket gets at most
// ONE winning row (highest-paying tier wins).
model LotteryWinning {
  id           String    @id @default(cuid())
  userId       String
  resultId     String
  // Unique so a ticket can never be paid twice, even if two scoring
  // passes race each other (settle vs score-orphans, double admin
  // click). NULLs are exempt (Postgres), which keeps legacy /
  // manual-award rows without a ticket reference valid.
  ticketId     String?   @unique
  ticketNumber String
  prizeTier    String // first_exact | first_ibox | second | third | special | consolation
  amount       Decimal   @db.Decimal(14, 2)
  status       String    @default("credited") // pending_credit | credited | cancelled
  createdAt    DateTime  @default(now())
  creditedAt   DateTime?
  // Set the first time the player closes the win celebration popup
  // (or when the win is already acknowledged). Server-side flag so
  // the popup stays suppressed across devices/sessions even if the
  // browser loses its localStorage marker. Never affects crediting.
  celebrationSeenAt DateTime?

  user   User              @relation(fields: [userId], references: [id])
  result LotteryDrawResult @relation(fields: [resultId], references: [id])

  @@index([userId])
  @@index([resultId])
  @@index([prizeTier])
}

model RewardItem {
  id                 String        @id @default(cuid())
  title              String
  titleBn            String?
  description        String?
  descriptionBn      String?
  cost               Int           @default(1000) // coin cost
  category           String        @default("misc") // recharge, spin, bet, physical, misc
  // rewardType controls the public claim flow:
  //   recharge  -> operator/phone form (Grameenphone, Robi, Banglalink, Airtel, Teletalk)
  //   physical  -> full name + phone + address + notes form
  //   digital   -> simple confirm (default; for spin tokens, free bets, etc.)
  rewardType         String        @default("digital")
  accent             String        @default("yellow") // yellow, blue, red, green
  imageUrl           String?
  bannerUrl          String?
  shortInstructionEn String?       @db.Text
  shortInstructionBn String?       @db.Text
  position           Int           @default(0)
  status             ContentStatus @default(active)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  claims RewardClaim[]

  @@index([status, position])
}

// Reward claim queue. Operator processes manually via admin. Coins
// are deducted on claim submission; refunded on rejection.
model RewardClaim {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  itemTitle   String
  rewardType  String
  costPaid    Int
  status      String    @default("pending") // pending | approved | rejected | done | cancelled
  payload     Json // recharge {operator, phone} | physical {name, phone, address, notes}
  notes       String?   @db.Text
  processedAt DateTime?
  processedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  item RewardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Daily check-in history. One row per (userId, day).
model DailyCheckInLog {
  id           String   @id @default(cuid())
  userId       String
  day          String // YYYY-MM-DD in UTC
  coinsAwarded Int
  streakDay    Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, createdAt])
}

// Spin wheel admin-configurable segments. Engine picks a segment by
// weight on every spin. payoutType controls what the reward does:
//   coins      -> credit reward coins
//   bonus      -> credit Wallet.bonusBalance with turnoverX requirement
//   freebet    -> issue a free-bet voucher (FUTURE)
//   freespin   -> issue spin tokens
//   nothing    -> no payout (consolation)
// Three-tier wheel ladder. Each tier holds its own SpinSegment rows
// + per-tier cost and free-spin allowance. Operator tunes from
// /admin/spin-segments. Legacy SpinSegment rows that pre-date this
// model keep tierId=null and continue to work via the engine fallback.
model SpinWheelTier {
  id              String   @id @default(cuid())
  key             String   @unique // 'lucky' | 'grand' | 'supreme'
  nameEn          String
  nameBn          String?
  descriptionEn   String?
  descriptionBn   String?
  costPerSpin     Int      @default(0)
  freeSpinsPerDay Int      @default(0)
  color           String   @default("#FFCC00")
  iconUrl         String?
  position        Int      @default(0)
  isActive        Boolean  @default(true)
  // Bumped on every payout-config change (segment activation, exclude
  // toggle, weight or amount edit). The 5b engine snapshots this value
  // onto WheelSpin so we can prove the eligible pool at spin time even
  // after later edits.
  configVersion   Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  segments   SpinSegment[]
  results    SpinResult[]
  wheelSpins WheelSpin[]

  @@index([isActive, position])
}

model SpinSegment {
  id              String    @id @default(cuid())
  label           String // e.g. "100", "X3"
  color           String    @default("#FFCC00")
  weight          Int       @default(1)
  payoutType      String    @default("coins") // coins | bonus | freebet | freespin | nothing
  payoutAmount    Int       @default(0)
  turnoverX       Decimal   @default(0) @db.Decimal(6, 2)
  position        Int       @default(0)
  isActive        Boolean   @default(true)
  // Server-only payout-eligibility flag. Set to true to keep the wedge
  // on the visual wheel (so the animation does not change for players)
  // but exclude it from the engine's weighted pick pool. NEVER returned
  // to the client; only the admin spin-segments endpoint exposes it.
  excludeFromWins Boolean   @default(false)
  excludeReason   String?
  excludeSetBy    String? // ActivityLog actorId of the admin who last toggled it
  excludeSetAt    DateTime?
  tierId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tier    SpinWheelTier?     @relation(fields: [tierId], references: [id], onDelete: SetNull)
  results SpinResult[]
  audits  SpinSegmentAudit[]

  @@index([isActive, position])
  @@index([tierId, isActive, position])
  @@index([excludeFromWins, tierId])
}

// Every toggle, edit or delete of a SpinSegment writes one of these.
// Captures who, when, before/after snapshots and the optional reason
// the admin typed when flipping excludeFromWins. The compliance
// engineering brief requires this trail so the operator can prove that
// no-prize wedges are not silently flipped on/off mid-event.
//
// segmentId uses onDelete:SetNull so the audit row survives the
// segment being deleted; the before/after JSON snapshots carry the
// segment label + tier link so the history view is still readable.
model SpinSegmentAudit {
  id            String   @id @default(cuid())
  segmentId     String?
  actorId       String?
  actorRole     String?
  changeType    String // 'exclude_on' | 'exclude_off' | 'edit' | 'create' | 'delete'
  reason        String?
  before        Json?
  after         Json?
  configVersion Int? // tier configVersion snapshot at change time
  createdAt     DateTime @default(now())

  segment SpinSegment? @relation(fields: [segmentId], references: [id], onDelete: SetNull)

  @@index([segmentId, createdAt])
  @@index([changeType, createdAt])
}

// One row per spin. Used for history + audit.
model SpinResult {
  id           String   @id @default(cuid())
  userId       String
  segmentId    String
  segmentLabel String
  payoutType   String
  payoutAmount Int
  cost         Int      @default(0) // 0 = free spin, >0 = paid in coins
  source       String   @default("manual") // manual | free_daily | login
  tierId       String?
  createdAt    DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment   SpinSegment    @relation(fields: [segmentId], references: [id])
  tier      SpinWheelTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  wheelSpin WheelSpin?

  @@index([userId, createdAt])
  @@index([tierId, createdAt])
}

// One row per engine invocation of the spin wheel. Mirrors SpinResult
// but adds the provenance the compliance brief requires: a snapshot of
// the EXACT eligible pool (winnable wedges + weights) that the engine
// considered for THIS spin, the tier's configVersion at that moment,
// the crypto.randomBytes-derived nonce and pick value, and the
// fallback flag set when the pool was empty and the engine had to
// refund the player.
//
// SpinResult stays the user-facing history row; WheelSpin is the
// internal audit-grade record. The two are linked via resultId.
model WheelSpin {
  id              String   @id @default(cuid())
  userId          String
  tierId          String?
  configVersion   Int?
  serverNonceHex  String // hex of crypto.randomBytes(4) used for the pick
  eligiblePool    Json // [{ segmentId, label, weight }] snapshot at spin time
  totalWeight     Int
  pickValue       Int // randomBytes -> uint32 mod totalWeight
  chosenSegmentId String?
  chosenLabel     String?
  payoutType      String?
  payoutAmount    Int?
  cost            Int      @default(0)
  source          String   @default("manual") // manual | free_daily | login
  fallbackUsed    Boolean  @default(false)
  fallbackReason  String?
  resultId        String?  @unique
  createdAt       DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier   SpinWheelTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  result SpinResult?    @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tierId, createdAt])
  @@index([fallbackUsed, createdAt])
}

// Unified bonus redesign: a batch of free wheel spins granted to a
// user on a specific SpinWheelTier. Sourced from a bonus rule's
// meta.freeSpins config, a deposit tier, or a manual admin grant.
// A grant is AVAILABLE while spinsUsed < spinsGranted AND
// (expiresAt is null OR expiresAt > now). tierKey maps to
// SpinWheelTier.key (e.g. 'lucky' | 'grand' | 'supreme').
model FreeSpinGrant {
  id           String    @id @default(cuid())
  userId       String
  tierKey      String
  spinsGranted Int
  spinsUsed    Int       @default(0)
  // Provenance so admin can trace a grant back to its trigger
  // (bonus rule, deposit tier, manual action, etc).
  sourceType   String?
  sourceId     String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Dedupe a concurrent re-grant of the same (deposit, rule) source: the
  // second create hits this unique and is swallowed by emitFreeSpinGrant's
  // best-effort catch. NULL sourceId rows (manual grants) are exempt in
  // Postgres, so hand-issued grants are never blocked.
  @@unique([userId, sourceType, sourceId])
  @@index([userId, tierKey])
  @@index([userId])
}

// ---------- Audit and system ----------

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String? // snapshot of role.key at action time
  action    String
  target    String?
  detail    String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model SupportTicket {
  id         String       @id @default(cuid())
  userId     String?
  // Guest fields. Logged-in submitters leave these blank; the engine
  // resolves the username + phone from the session at read time.
  name       String?
  email      String?
  phone      String?
  subject    String
  body       String       @db.Text
  status     TicketStatus @default(open)
  // Admin-only triage fields.
  adminNote  String?      @db.Text
  resolvedAt DateTime?
  resolvedBy String?
  ip         String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ---------- M2H Player Recovery CRM ----------

// Admin-configurable inactivity rule. Drives both the read-only
// segment preview (which users currently match) and the automatic
// task spawner (when autoCreateTasks=true the cron sweep creates a
// RecoveryTask for every matching user that does not already have an
// open task).
//
// kind values:
//   no_login        threshold = days since lastLoginAt
//   no_deposit      threshold = days since last approved deposit
//   no_bet          threshold = days since last Transaction(type=bet|win)
//                                (proxy until the live wager engine ships)
//   balance_below   threshold = BDT, matches users with wallet.balance < threshold
model RecoveryRule {
  id              String        @id @default(cuid())
  key             String?       @unique // optional stable lookup key
  name            String
  kind            String // see comment above
  threshold       Decimal       @default(0) @db.Decimal(14, 2)
  segmentLabel    String?
  priority        Int           @default(0)
  status          ContentStatus @default(active)
  autoCreateTasks Boolean       @default(false)
  meta            Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tasks RecoveryTask[]

  @@index([status])
  @@index([kind])
}

// One CRM follow-up on one user, assigned to (or worked by) one staff
// member. Lifecycle:
//   open          newly materialized, not yet claimed
//   in_progress   claimed by a staff (lockedByStaffId set, lockedUntil
//                  set to now + claim TTL). Two staff cannot work the
//                  same task while the lock is live.
//   won           staff converted the player (deposited, called back,
//                  etc.). Recorded on close.
//   lost          staff exhausted attempts, no conversion.
//   abandoned     admin manually cancelled.
model RecoveryTask {
  id                 String    @id @default(cuid())
  userId             String
  ruleId             String?
  assignedToStaffId  String?
  status             String    @default("open")
  lockedByStaffId    String?
  lockedUntil        DateTime?
  lastAttemptAt      DateTime?
  lastAttemptOutcome String?
  attemptCount       Int       @default(0)
  closeReason        String?
  closedAt           DateTime?
  closedByStaffId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User                 @relation("RecoveryTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  rule     RecoveryRule?        @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  attempts RecoveryContactLog[]

  // Idempotency: we only allow one open/in_progress task per (user, rule)
  // pair. Closed tasks are kept for audit.
  @@index([userId])
  @@index([status])
  @@index([assignedToStaffId])
  @@index([lockedByStaffId])
  @@index([ruleId])
}

// Per-attempt audit ledger. Every call / sms / whatsapp / note logged
// here. Powers the staff performance report and the timeline a
// supervisor sees on a task. Channel + outcome are free strings so
// the admin can add new outreach methods without a schema change.
model RecoveryContactLog {
  id          String   @id @default(cuid())
  taskId      String
  staffId     String
  channel     String // call | sms | whatsapp | email | other
  outcome     String // no_answer | callback | not_interested | converted | wrong_number | other
  notes       String?  @db.Text
  meta        Json?
  attemptedAt DateTime @default(now())

  task RecoveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, attemptedAt])
  @@index([staffId, attemptedAt])
}

// ---------- M2I Notifications + Tracking ----------

// Per-send audit ledger for outbound SMS / WhatsApp / email. Captures
// who triggered it, which adapter handled the send, success/failure
// and the provider reference for support follow-up. Used by the
// /admin/notifications history view and by retry/dedupe logic so a
// retry attempt can find the prior failed send.
model NotificationLog {
  id         String   @id @default(cuid())
  channel    String // sms | whatsapp | email | other
  provider   String? // adapter key actually used (sslwireless, twilio, manual, test, ...)
  recipient  String // phone or email - kept plain text for support; never logged in app logs
  template   String? // otp_request | deposit_approved | withdrawal_paid | recovery_message | custom
  body       String   @db.Text
  userId     String?
  triggerKey String? // optional dedupe key (e.g. otp:<phone>:<purpose>)
  ok         Boolean  @default(false)
  ref        String? // provider message id
  errorCode  String?
  errorBody  String?  @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([channel, createdAt])
  @@index([userId, createdAt])
  @@index([triggerKey])
}

// Per-fire audit ledger for tracking pixel + conversion events.
// Each row is one canonical event that may fan out to multiple
// platforms (FB, TikTok, GA4, Google Ads). Status is recorded per
// platform inside `meta.results`. Powers the admin tracking page so
// the operator can verify a pixel actually fired.
model TrackingEvent {
  id        String   @id @default(cuid())
  event     String // signup | login | deposit | withdrawal | lotto_bet | bonus_claim | custom
  source    String   @default("server") // server | client
  userId    String?
  value     Decimal? @db.Decimal(14, 2)
  currency  String?  @default("BDT")
  reference String? // depositId, withdrawalId, etc
  payload   Json?
  results   Json? // per-platform { fb: 'ok' | 'skipped:no_id' | 'error:...' }
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
}

// ---------- M2K Security ----------

// Append-only ledger of every login attempt (success + failure).
// Powers the suspicious-activity heuristics, the per-user device
// history on /dashboard/security, and the admin /admin/security
// login-attempt feed. Failed attempts also accumulate here so the
// rate-limit bucket is no longer the only signal of brute force.
model LoginAttempt {
  id         String   @id @default(cuid())
  // identifier the user typed (username or phone). Useful for failed
  // attempts where we never resolved a userId.
  identifier String
  userId     String?
  surface    String // 'user' | 'admin'
  ip         String?
  userAgent  String?  @db.Text
  success    Boolean  @default(false)
  reason     String? // 'ok' | 'bad_password' | 'unknown_user' | 'blocked' | 'rate_limited' | '2fa_required' | '2fa_failed' | 'ip_blocked'
  // Heuristic flags surfaced at login time, comma-joined for cheap
  // filtering (eg 'new_ip,foreign_country').
  flags      String?
  createdAt  DateTime @default(now())

  user User? @relation("LoginAttemptUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@index([success, createdAt])
}

// Admin-managed IP block list. Middleware consults this BEFORE the
// JWT check so a blocked IP cannot probe admin or auth surfaces.
// Supports both single IPs and CIDR ranges. The cron sweep clears
// rows past expiresAt so temp blocks self-heal.
model IpBlockRule {
  id          String    @id @default(cuid())
  ip          String // either a single ip or a CIDR (10.0.0.0/24)
  reason      String?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([ip])
  @@index([expiresAt])
}

model SystemSetting {
  id        String          @id @default(cuid())
  key       String          @unique
  value     String          @db.Text
  type      String          @default("string") // string, number, boolean, json
  category  SettingCategory @default(general)
  updatedAt DateTime        @updatedAt
}

model PaymentMethod {
  id                  String        @id @default(cuid())
  name                String        @unique
  type                String        @default("mobile") // mobile, bank, crypto
  status              ContentStatus @default(active)
  number              String
  instruction         String        @db.Text
  position            Int           @default(0)
  // M2C: per-method enable flags + amount caps. depositEnabled keeps
  // backwards compatibility (existing rows treated as deposit-enabled);
  // payoutEnabled defaults to false so a method must be explicitly
  // allowed for withdrawals.
  depositEnabled      Boolean       @default(true)
  payoutEnabled       Boolean       @default(false)
  minDeposit          Decimal?      @db.Decimal(14, 2)
  maxDeposit          Decimal?      @db.Decimal(14, 2)
  minWithdrawal       Decimal?      @db.Decimal(14, 2)
  maxWithdrawal       Decimal?      @db.Decimal(14, 2)
  payoutInstruction   String?       @db.Text
  // Babu88-style icon picker. iconUrl is the small square logo on the
  // /deposit + /withdraw method tiles; bannerUrl is the wide banner
  // shown on the SelectedPaymentMethodDetails panel. Bn variants of
  // both instruction fields let the operator localise without losing
  // the existing single-language rows.
  iconUrl             String?
  bannerUrl           String?
  instructionBn       String?       @db.Text
  payoutInstructionBn String?       @db.Text
  // Operator-editable badge that appears in the corner of the method
  // tile on /deposit + /withdraw. Empty / null label falls back to the
  // hard-coded default ("AUTO" for express methods, "MANUAL" for the
  // rest). badgeEnabled=false hides the badge entirely.
  badgeLabelEn        String?       @db.VarChar(24)
  badgeLabelBn        String?       @db.VarChar(24)
  badgeEnabled        Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status, position])
}

// ---------- Pasha Native Games (Phase 1: Dice + Mines) ----------
//
// One row per playable internal game. Admins toggle isActive, min/max
// bet caps and houseEdgeBps from /admin/native-games. config is a
// per-game JSON blob:
//   Dice  -> { minTarget, maxTarget }
//   Mines -> { gridSize, minMines, maxMines }
// Commercial provider integrations (Jili, PG Soft, etc) live in
// GameProvider above; this model is strictly for in-house games whose
// outcomes are derived on our server.
model NativeGameProvider {
  id           String   @id @default(cuid())
  gameCode     String   @unique
  displayName  String
  isActive     Boolean  @default(true)
  // Phase 2: shown on the homepage Hot Games strip when true. Hidden
  // rows still play if isActive and reachable directly via /games/<code>.
  isFeatured   Boolean  @default(false)
  // Lower values surface first on the homepage + /games lobby; ties
  // fall back to displayName order.
  sortOrder    Int      @default(0)
  houseEdgeBps Int      @default(200)
  minBet       Decimal  @default(10) @db.Decimal(14, 2)
  maxBet       Decimal  @default(10000) @db.Decimal(14, 2)
  config       Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions GameSession[]
  rounds   GameRound[]
}

// One provably-fair session per (user, game). serverSeed is stored
// AEAD-encrypted via lib/crypto/aead.ts. Only serverSeedHash is
// returned while the session is ACTIVE; the plaintext seed is revealed
// once status flips to COMPLETED or EXPIRED so the player can verify
// every round outcome themselves.
model GameSession {
  id             String   @id @default(cuid())
  userId         String
  gameCode       String
  serverSeed     String   @db.Text // AEAD-encrypted blob
  serverSeedHash String // SHA-256 hex, public
  clientSeed     String
  nonce          Int      @default(0)
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | EXPIRED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   NativeGameProvider @relation(fields: [gameCode], references: [gameCode])
  rounds GameRound[]

  @@index([userId, gameCode, status])
  @@index([userId, createdAt])
}

// One round per bet. idempotencyKey (unique) blocks double-settle when
// a client retries the same bet. gameData is gameCode-specific:
//   Dice  -> { target, direction, result }
//   Mines -> { mineCount, minePositions (server-only until settled),
//              revealedTiles, currentMultiplier }
// payoutAmount is the gross credit applied on win or cashout (0 on
// loss). The bet debit + win credit each get their own Transaction
// row keyed by `reference = round.id`.
model GameRound {
  id               String    @id @default(cuid())
  sessionId        String
  userId           String
  gameCode         String
  nonce            Int
  betAmount        Decimal   @db.Decimal(14, 2)
  payoutAmount     Decimal   @default(0) @db.Decimal(14, 2)
  payoutMultiplier Decimal   @default(0) @db.Decimal(10, 4)
  gameData         Json?
  outcome          String    @default("PENDING") // PENDING | WIN | LOSS | CASHOUT | CANCELLED
  settledAt        DateTime?
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())

  session GameSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  game    NativeGameProvider @relation(fields: [gameCode], references: [gameCode])

  @@index([userId, gameCode, createdAt])
  @@index([sessionId])
  @@index([outcome, createdAt])
}

// =====================================================================
// M4 Phase A: launch-readiness models. All additive. Zero column
// changes on existing tables except the six optional columns added to
// BonusRule above. `prisma db push` is safe.
// =====================================================================

// Unified directory of public-facing sections. Drives show/hide,
// reorder and title editing for every public block: homepage strips,
// the about/sponsorship region, the public payment-method row, the
// promotion grid, etc. Every consumer fetches its `meta` blob for
// section-specific knobs (e.g. card layout, accent colour).
model PublicSection {
  id         String   @id @default(cuid())
  key        String   @unique
  group      String
  titleEn    String
  titleBn    String?
  subtitleEn String?
  subtitleBn String?
  isVisible  Boolean  @default(true)
  position   Int      @default(0)
  layout     String?
  meta       Json?
  updatedAt  DateTime @updatedAt

  @@index([group, position])
  @@index([isVisible, position])
}

// Curated homepage featured-game list. Admins pick up to 20 games
// across providers (external) and native games. `source` distinguishes
// the FK target. Soft FK so provider re-imports cannot orphan-cascade
// the curation. The assembler filters to rows whose underlying game
// is still active at render time.
model HomepageFeaturedGame {
  id                String   @id @default(cuid())
  source            String
  externalGameId    String?
  nativeGameCode    String?
  position          Int      @default(0)
  isHot             Boolean  @default(false)
  isJackpot         Boolean  @default(false)
  // Operator-uploaded thumbnail that overrides the provider/native
  // game's default imageUrl. Stored as a /uploads/<category>/... URL.
  // When null the public assembler falls back to the underlying
  // ExternalGame.imageUrl (provider catalogue) so cleared overrides
  // restore the provider thumbnail without admin re-input.
  customImageUrl    String?
  // Per-row overlay visibility. Defaults preserve the legacy card
  // layout (provider label, game name, HOT badge, Play button all
  // visible). imageOnlyMode lets the operator hide every overlay so
  // a pre-designed promotional thumbnail renders edge-to-edge.
  showProviderLabel Boolean  @default(true)
  showGameName      Boolean  @default(true)
  showHotBadge      Boolean  @default(true)
  showPlayButton    Boolean  @default(true)
  imageOnlyMode     Boolean  @default(false)
  // How the public card fits the uploaded image. 'cover' fills the
  // tile (may crop). 'contain' shows the full image with a blurred
  // copy of the image as the background so the tile never goes white.
  imageFitMode      String   @default("cover")
  addedBy           String
  createdAt         DateTime @default(now())

  @@index([position])
  @@index([isHot, position])
  @@index([isJackpot, position])
}

// Flexible homepage block. Replaces the single-list HomepageFeaturedGame
// model when the operator needs more than one curated strip. Each block
// renders on the public homepage in `position` order with its own title
// + subtitle. `sourceType` controls what fills it:
//   manual    -> the linked HomepageGameBlockItem rows in this block
//   category  -> live ExternalGame rows matching `category`
//   brand     -> live ExternalGame rows for the brand pointed at by `brandId`
//   jackpot   -> live ExternalGame rows where isJackpot=true
//   featured  -> top isFeatured rows (no manual curation needed)
// Empty blocks auto-hide on the public homepage; layout="grid" is the
// default tile rendering. The existing PublicSection / HomepageFeaturedGame
// surfaces continue to work unchanged; HomepageGameBlock rows render
// after them on the public homepage.
model HomepageGameBlock {
  id         String   @id @default(cuid())
  key        String   @unique
  titleEn    String
  titleBn    String?
  subtitleEn String?
  subtitleBn String?
  sourceType String   @default("manual")
  category   String?
  brandId    String?
  limit      Int      @default(12)
  position   Int      @default(0)
  isVisible  Boolean  @default(true)
  layout     String?  @default("grid")
  meta       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items HomepageGameBlockItem[]

  @@index([isVisible, position])
}

model HomepageGameBlockItem {
  id             String   @id @default(cuid())
  blockId        String
  source         String
  externalGameId String?
  nativeGameCode String?
  position       Int      @default(0)
  isHot          Boolean  @default(false)
  isJackpot      Boolean  @default(false)
  createdAt      DateTime @default(now())

  block HomepageGameBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, position])
}

// Pre-deposit notice popup. Multiple rows supported so the operator
// can publish a fraud-warning notice + a processing-time notice in
// sequence. `position` controls render order; `isEnabled` flips the
// row off without deleting it.
model DepositNotice {
  id         String   @id @default(cuid())
  isEnabled  Boolean  @default(false)
  titleEn    String
  titleBn    String?
  bodyEn     String   @db.Text
  bodyBn     String?  @db.Text
  ctaLabelEn String   @default("I understand")
  ctaLabelBn String?
  position   Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@index([isEnabled, position])
}

// Deposit-tier bonuses (e.g. 1000 BDT = 3%, 5000 BDT = 5%). This is
// admin UI sugar over the bonus engine: tier rows are materialised
// into BonusRule rows by the deposit-tier service at write time.
// Keeping the tier definition separate lets the editor present one
// flat table instead of a per-rule form.
model DepositBonusTier {
  id            String   @id @default(cuid())
  minDeposit    Decimal  @db.Decimal(14, 2)
  percentage    Int
  isActive      Boolean  @default(true)
  position      Int      @default(0)
  // Per-grant wager multiplier applied to the bonus amount. e.g. a
  // 500 BDT bonus with turnoverX=10 creates a UserBonus grant with
  // turnoverRequired=5000. The withdrawal gate (deposit-gate.ts)
  // aggregates active UserBonus rows in the deposit family and blocks
  // withdrawal until the wager progress catches up. Default 0 keeps
  // backwards compatibility with tiers created before this field
  // shipped - bonus credits to balance but is not under its own lock,
  // and the lifetime deposit_turnover_multiplier gate is the only
  // wager requirement. Set to a positive value to require the player
  // to wager the bonus before being able to withdraw it.
  turnoverX     Decimal  @default(0) @db.Decimal(10, 2)
  // Per-user claim limit mirrored from BonusRule. claimPeriod: unlimited
  // (default, no cap) | account (lifetime) | day | week | month (rolling
  // window). claimLimit is the max grants allowed per period (0 with a
  // non-unlimited period means 1). Passed through into the managed
  // BonusRule via syncTierToBonusRule so the engine enforces it.
  claimPeriod   String?  @default("unlimited")
  claimLimit    Int      @default(0)
  // Admin-curated card data. When set, /promotions and /admin previews
  // render this content instead of the auto-generated "Auto-managed by
  // /admin/deposit-bonus-tiers" placeholder. titleEn/Bn override the
  // synced BonusRule name; descriptionEn/Bn override the description;
  // bannerUrl replaces the gradient placeholder on the promotion card.
  titleEn       String?
  titleBn       String?
  descriptionEn String?  @db.Text
  descriptionBn String?  @db.Text
  bannerUrl     String?
  updatedAt     DateTime @updatedAt

  @@index([isActive, position])
  @@index([minDeposit])
}

// Referral wallet ledger. The main Wallet stays untouched; commissions
// land here first as `pendingAmount`, mature into `claimableAmount`
// after the configurable hold window (default 7 days, admin-tunable),
// and move into `claimedAmount` once the user transfers them to the
// main wallet via a ReferralClaim row. Backfilled from existing
// AffiliateCommission rows in Phase E.
model ReferralBalance {
  userId          String    @id
  pendingAmount   Decimal   @default(0) @db.Decimal(14, 2)
  claimableAmount Decimal   @default(0) @db.Decimal(14, 2)
  claimedAmount   Decimal   @default(0) @db.Decimal(14, 2)
  lastClaimedAt   DateTime?
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per player-initiated transfer from referral balance into
// the main wallet. `walletTxId` is the resulting Transaction.id once
// the transfer settles, so the audit trail is reversible.
model ReferralClaim {
  id         String    @id @default(cuid())
  userId     String
  amount     Decimal   @db.Decimal(14, 2)
  status     String    @default("pending")
  walletTxId String?
  payoutId   String?   @unique
  errorCode  String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Promotion claim ledger. One row per attempt. The unique constraint
// blocks duplicate daily/weekly/first-deposit claims at the database
// layer, eliminating a UI race window. `dayBucket` is the natural
// dedup key: 'YYYY-MM-DD' for daily; 'YYYY-Www' for weekly;
// 'first_deposit' for one-shot first-deposit type rules.
model PromotionClaim {
  id           String   @id @default(cuid())
  userId       String
  ruleId       String
  dayBucket    String
  status       String
  bonusGrantId String?
  errorCode    String?
  createdAt    DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule BonusRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId, dayBucket])
  @@index([userId, createdAt])
  @@index([ruleId, createdAt])
}

// Per-category upload constraints for /api/admin/uploads and the
// reusable <ImageUpload> widget. Lets the operator see required
// dimensions, accepted MIME types and the byte cap inline on every
// banner/icon field. Phase D wires the widget to read this table.
model UploadConstraint {
  id             String   @id @default(cuid())
  categoryKey    String   @unique
  label          String
  requiredWidth  Int?
  requiredHeight Int?
  acceptedMime   String
  maxBytes       Int
  noteEn         String?
  noteBn         String?
  updatedAt      DateTime @updatedAt
}

// Public brand ambassadors block. Replaces the hardcoded AMBASSADORS
// array in Footer.tsx. `subtitle` carries the '2025/2026' style line
// from the reference design. Reorder via `position`.
model BrandAmbassador {
  id        String   @id @default(cuid())
  nameEn    String
  nameBn    String?
  iconUrl   String?
  subtitle  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// Public sponsors block. Same shape as BrandAmbassador; separate
// table so admins can manage the two lists independently (the public
// design renders them as two distinct rows).
model Sponsor {
  id        String   @id @default(cuid())
  nameEn    String
  nameBn    String?
  iconUrl   String?
  subtitle  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// Public payment-method display row. INDEPENDENT from PaymentMethod
// (the real-gateway model used by the deposit pipeline). This table
// only drives the public icon pills shown on the homepage / footer
// / about block. Lets the operator show/hide brands without touching
// the gateway configuration.
model PublicPaymentMethod {
  id         String   @id @default(cuid())
  buttonText String
  iconUrl    String?
  position   Int      @default(0)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt

  @@index([isActive, position])
}

// ==========================================================================
// Betting Pass. Operator-configurable tier ladder. Players earn points by
// depositing and wagering. Each tier unlocks a one-time reward (coins,
// bonus or freebet) the player claims through /betting-pass.
//
// Three tables, all additive. Idempotency keys on BettingPassEvent block
// double-awarding the same deposit or the same bet. UserBettingPassProgress
// holds the rolling totals so the user page does not have to aggregate
// the event log on every render.
// ==========================================================================

// Admin-tunable tier rule. One row per tier. `pointsRequired` is the
// cumulative threshold (player needs `pointsRequired` lifetime points
// to unlock this tier). `rewardKind` decides what the claim does:
//   coins      -> Wallet.bonusBalance increment
//   bonus      -> grantBonusInTx via BonusRule with name `betting_pass:<ruleId>`
//   freebet    -> Wallet.lockedBalance increment (legacy parity with spin)
//   physical   -> no wallet movement, RewardClaim-style payload only
model BettingPassRule {
  id             String   @id @default(cuid())
  tier           Int      @unique
  nameEn         String
  nameBn         String?
  descriptionEn  String?
  descriptionBn  String?
  iconUrl        String?
  pointsRequired Int // lifetime points to unlock
  rewardKind     String   @default("coins") // coins|bonus|freebet|physical
  rewardAmount   Decimal  @default(0) @db.Decimal(14, 2)
  // Wager multiplier applied to bonus payouts so the claim engine can
  // create a tracked UserBonus grant (amount * turnoverX = turnover
  // required). 0 means no wager gate. Coins/freebet/physical reward
  // kinds ignore this value. Snapshotted per-claim in
  // BettingPassClaim.errorCode meta so admin rate changes never
  // rewrite history.
  turnoverX      Decimal  @default(0) @db.Decimal(6, 2)
  bonusRuleId    String? // optional reference if rewardKind=bonus
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  claims BettingPassClaim[]

  @@index([isActive, pointsRequired])
}

// Per-user accumulated points + current tier. Updated whenever
// BettingPassEvent rows are written. Read by /api/betting-pass/me.
model UserBettingPassProgress {
  userId            String    @id
  pointsTotal       Decimal   @default(0) @db.Decimal(14, 2)
  pointsFromDeposit Decimal   @default(0) @db.Decimal(14, 2)
  pointsFromBet     Decimal   @default(0) @db.Decimal(14, 2)
  currentTier       Int       @default(0)
  lastEventAt       DateTime?
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Ledger row for every point award. idempotencyKey is unique so a
// re-fired deposit-approve or duplicate provider settle never
// double-awards points. source tells the engine where the points came
// from: 'deposit' (depositId) or 'bet' (providerTransactionId).
model BettingPassEvent {
  id                String   @id @default(cuid())
  userId            String
  source            String // 'deposit' | 'bet' | 'manual'
  sourceId          String? // Deposit.id or ProviderTransaction.id
  points            Decimal  @db.Decimal(14, 2)
  pointsFromDeposit Decimal  @default(0) @db.Decimal(14, 2)
  pointsFromBet     Decimal  @default(0) @db.Decimal(14, 2)
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([source, sourceId])
}

// Records each tier reward claim. The (userId, ruleId) pair is unique
// so a tier reward can only be claimed once per player. status flips
// to 'paid' after the wallet/bonus credit succeeds.
model BettingPassClaim {
  id           String   @id @default(cuid())
  userId       String
  ruleId       String
  tier         Int
  rewardKind   String
  rewardAmount Decimal  @db.Decimal(14, 2)
  status       String   @default("paid")
  walletTxId   String?
  bonusGrantId String?
  errorCode    String?
  createdAt    DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule BettingPassRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId])
  @@index([userId, createdAt])
}

// Operator-managed banner deck for the public /betting-pass hero.
// Rendered as a swipeable / auto-rotating carousel. When zero rows
// are active, the page falls back to the hardcoded built-in hero so
// the surface never breaks on a fresh DB.
model BettingPassBanner {
  id         String   @id @default(cuid())
  titleEn    String
  titleBn    String?
  subtitleEn String?
  subtitleBn String?
  imageUrl   String?
  ctaUrl     String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Operator-managed banner deck for the public /promotions hero.
// Empty decks fall back to the built-in CategoryHero.
model PromotionBanner {
  id         String   @id @default(cuid())
  titleEn    String
  titleBn    String?
  subtitleEn String?
  subtitleBn String?
  imageUrl   String?
  ctaUrl     String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Operator-curated homepage video. Source is either a YouTube URL
// (parsed to videoId so the public carousel can render the standard
// thumbnail + embed) or a directly uploaded mp4/webm served from
// /uploads/videos. The carousel renders 1+ active rows ordered by
// sortOrder; an empty deck falls back to whatever the homepage video
// section rendered before this model existed. All fields are
// additive; nothing else in the schema references this table.
// Operator-managed sports fixture rendered in the homepage Sportsbook
// carousel as a Babu-style event card (status pill + league line + date
// + two teams). Until a real provider feed adapter is wired the admin
// adds rows manually. When a feed adapter ships, the importer should
// upsert into this table by (providerName, providerEventId) so the
// admin UI continues to render the same cards without code changes.
// All fields are additive; nothing else in the schema references this
// table.
model SportsEvent {
  id              String    @id @default(cuid())
  sportType       String    @default("cricket")
  status          String    @default("upcoming")
  leagueNameEn    String
  leagueNameBn    String?
  startsAt        DateTime
  endsAt          DateTime?
  teamAName       String
  teamAShortName  String?
  teamALogoUrl    String?
  teamBName       String
  teamBShortName  String?
  teamBLogoUrl    String?
  providerName    String?
  providerEventId String?
  deepLinkUrl     String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  source          String    @default("manual")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, startsAt])
  @@index([status, startsAt])
  @@index([providerName, providerEventId])
}

model HomepageVideo {
  id             String   @id @default(cuid())
  titleEn        String
  titleBn        String?
  subtitleEn     String?
  subtitleBn     String?
  sourceType     String   @default("youtube")
  youtubeUrl     String?
  youtubeVideoId String?
  videoUrl       String?
  thumbnailUrl   String?
  ctaUrl         String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Single-use or multi-use promo code that grants a configured payout
// (bonus grant, main balance credit, locked freebet) on redemption.
// The redeem service runs in a Prisma transaction, writes a wallet
// Transaction + ActivityLog and reuses the existing bonus engine when
// the reward is a turnover-locked grant. PromoCodeRedemption blocks
// duplicate per-user redemptions via @@unique([promoCodeId, userId]).
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  titleEn         String
  titleBn         String?
  descriptionEn   String?   @db.Text
  descriptionBn   String?   @db.Text
  // Reward shape. 'bonus_grant' routes through the existing bonus
  // engine (turnoverX gate, locked balance). 'main_balance' credits
  // Wallet.balance directly. 'bonus_balance' credits Wallet.bonusBalance.
  // 'locked_balance' credits Wallet.lockedBalance (freebet).
  rewardType      String    @default("bonus_grant")
  rewardAmount    Decimal   @default(0) @db.Decimal(14, 2)
  // Turnover multiplier applied to the credited amount. Only honoured
  // when rewardType is 'bonus_grant' or 'locked_balance'.
  turnoverX       Decimal   @default(0) @db.Decimal(6, 2)
  // Stops accepting redemptions once total redemptions reaches this
  // value. 0 disables the cap.
  maxRedemptions  Int       @default(0)
  // Maximum redemptions per individual user. 1 is the standard
  // single-use behaviour. Higher values support multi-use codes.
  perUserLimit    Int       @default(1)
  // Minimum approved deposit total (in BDT) required before the user
  // can redeem. 0 disables the gate.
  minDepositTotal Decimal   @default(0) @db.Decimal(14, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  // Optional fk to a BonusRule for rewardType='bonus_grant' so the
  // grant inherits the rule's validityDays + turnoverX + max bonus
  // cap. When null the engine builds a synthetic transient rule from
  // rewardAmount + turnoverX so the grant still respects the standard
  // UserBonus / locked balance contract.
  bonusRuleId     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bonusRule   BonusRule?            @relation(fields: [bonusRuleId], references: [id])
  redemptions PromoCodeRedemption[]

  @@index([isActive, endsAt])
}

model PromoCodeRedemption {
  id             String   @id @default(cuid())
  promoCodeId    String
  userId         String
  amount         Decimal  @db.Decimal(14, 2)
  rewardType     String
  bonusGrantId   String?
  walletTxId     String?
  // Stable idempotency key. The redeem service derives this from
  // (promoCodeId, userId, sequence) so retries collide here instead
  // of double-crediting the wallet.
  idempotencyKey String   @unique
  status         String   @default("granted")
  createdAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([promoCodeId, createdAt])
}

// Operator-broadcast in-app notification. NotificationRecipient
// fan-out is created at send time, one row per targeted user, so the
// per-user unread query stays O(1) and the user can mark each
// notification read independently. Optional soundUrl points at a
// short audio asset uploaded via the existing /api/admin/uploads
// pipeline so the operator can override the default chime per
// campaign. The model intentionally captures BOTH bilingual fields
// so a single notification renders correctly for every player.
model Notification {
  id          String   @id @default(cuid())
  titleEn     String
  titleBn     String?
  bodyEn      String?  @db.Text
  bodyBn      String?  @db.Text
  linkUrl     String?
  imageUrl    String?
  soundUrl    String?
  priority    String   @default("normal")
  status      String   @default("sent")
  audience    String   @default("all")
  // Category tag used by the player-side UI to pick the right
  // celebration popup. Free string; known values are 'cashback',
  // 'lotto_win', 'spin_win', null for generic broadcast.
  kind        String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy  User?                   @relation("NotificationsCreated", fields: [createdById], references: [id])
  recipients NotificationRecipient[]

  @@index([createdAt])
  @@index([status, createdAt])
}

// Browser push subscription registered via the service worker after
// the player taps "Enable device notifications". One row per
// (user, endpoint) pair so a single user can receive push on multiple
// devices. Inactive rows are kept in the table for diagnostic
// purposes; the dispatcher only sends to isActive=true rows and flips
// the flag off when the provider returns 404/410 (expired/unsubscribed).
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  deviceLabel   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime  @default(now())
  failedAt      DateTime?
  failureReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

// FCM registration token for an admin's phone, registered when a staff
// user taps "Enable phone alerts" in the admin panel. One row per
// (admin user, device token) so a single admin can receive push on
// multiple phones. Kept separate from the player-facing PushSubscription
// table so the admin phone-alert flow and the player web-push flow never
// interfere. The dispatcher (lib/push/fcm.ts) only sends to isActive=true
// rows and flips the flag off when FCM returns a token-not-registered
// error.
model AdminPushDevice {
  id            String    @id @default(cuid())
  userId        String
  token         String    @unique
  userAgent     String?
  deviceLabel   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSeenAt    DateTime  @default(now())
  failedAt      DateTime?
  failureReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Bulk SMS or Email campaign. Created by an admin from
// /admin/campaigns. The dispatch is provider-gated: when SMS or SMTP
// provider keys are absent the row stays in 'provider_setup_required'
// status. No CampaignRecipient is ever marked sent unless the
// provider returns ok. The admin can still build out the message body,
// audience and recipient list; pressing Send only writes the
// scheduled-time and provider attempt, never a fake success.
model Campaign {
  id             String    @id @default(cuid())
  channel        String
  title          String
  subject        String?
  body           String    @db.Text
  audience       String    @default("all")
  status         String    @default("draft")
  providerStatus String?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sentAt         DateTime?

  createdBy  User?               @relation("CampaignsCreated", fields: [createdById], references: [id])
  recipients CampaignRecipient[]

  @@index([channel, status])
  @@index([createdAt])
}

model CampaignRecipient {
  id                String    @id @default(cuid())
  campaignId        String
  userId            String?
  phone             String?
  email             String?
  status            String    @default("queued")
  providerMessageId String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([userId, createdAt])
}

// Operator-defined cashback program. Each campaign captures the
// formula (net_loss or wager_amount), the percentage, the cap and the
// turnover lock applied to credited cashback. CashbackPayout records
// every credit so the same campaign + user + period combination cannot
// be double-paid; idempotencyKey is unique by construction.
model CashbackCampaign {
  id          String    @id @default(cuid())
  nameEn      String
  nameBn      String?
  source      String    @default("net_loss")
  percentage  Decimal   @default(0) @db.Decimal(5, 2)
  maxCashback Decimal   @default(0) @db.Decimal(14, 2)
  turnoverX   Decimal   @default(0) @db.Decimal(6, 2)
  cadence     String    @default("weekly")
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  // Scope filter. 'all' (default) sums every bet/win Transaction in
  // the window; 'match' restricts the sum to Transaction rows whose
  // meta.scope is one of scopeKeys (e.g. ['casino'], ['sports'],
  // ['casino','live_casino']). Bet/win Transactions stamp
  // meta.scope at write time (native games stamp 'casino'; sports
  // / external providers will stamp their own scope when integrated).
  scopeType   String    @default("all")
  scopeKeys   String[]  @default([])
  bonusRuleId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bonusRule BonusRule?       @relation(fields: [bonusRuleId], references: [id])
  payouts   CashbackPayout[]

  @@index([isActive, endsAt])
}

model CashbackPayout {
  id             String   @id @default(cuid())
  campaignId     String
  userId         String
  periodKey      String
  baseAmount     Decimal  @db.Decimal(14, 2)
  cashbackAmount Decimal  @db.Decimal(14, 2)
  walletTxId     String?
  bonusGrantId   String?
  status         String   @default("granted")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  campaign CashbackCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, periodKey])
  @@index([userId, createdAt])
  @@index([campaignId, createdAt])
}

// ---------- WinGo Tournaments ----------
//
// Honest player-engagement tournaments scoped to the WinGo native game.
// Ranking metric is TOTAL WAGERED: the sum of WingoBet.betAmount by each
// player whose createdAt falls in [startsAt, endsAt). Mirrors the
// cashback engine blueprint (CashbackCampaign / CashbackPayout): a
// single guarded status transition settles the tournament and pays the
// top ranks idempotently, each payout keyed by a unique idempotencyKey.
//
// Lifecycle: draft -> active -> ended -> paid, plus a terminal 'void'.
// active while now in [startsAt, endsAt); ended once now >= endsAt
// (leaderboard frozen); paid once settlement credits the winners. An
// admin may void a draft/active/ended tournament before it is paid; a
// voided tournament never pays.
//
// prizes is an ordered JSON list [{rank:1,amount},{rank:2,amount},...]
// for the top N; ranks must be 1..N contiguous + unique and amounts > 0.
// Each prize credits the winner's MAIN balance with an optional
// per-tournament turnoverX lock (default 1) applied as a UserBonus via
// the bonus engine's 'tournament_prize' direct-balance source, so prizes
// are wagered once before withdrawal; turnoverX = 0 means pure cash.
model Tournament {
  id          String    @id @default(cuid())
  nameEn      String
  nameBn      String?
  // draft | active | ended | paid | void.
  status      String    @default("draft")
  // Game scope. WinGo only for now; kept for future metrics.
  scope       String    @default("wingo")
  // Ranking metric. 'turnover' = sum of WingoBet.betAmount in window.
  rankMetric  String    @default("turnover")
  startsAt    DateTime
  endsAt      DateTime
  // Ordered prize table [{ rank, amount }] for the top N.
  prizes      Json      @default("[]")
  // Turnover multiplier locked on each prize (0 = pure cash).
  turnoverX   Decimal   @default(1) @db.Decimal(6, 2)
  // Minimum wagered score a user must reach to qualify (0 = all).
  minTurnover Decimal   @default(0) @db.Decimal(14, 2)
  createdById String?
  // Stamped when settlement claims the tournament (ended -> settling), so
  // the freeze stays atomic. Crediting completes shortly after.
  settledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User?              @relation("TournamentsCreated", fields: [createdById], references: [id])
  payouts   TournamentPayout[]

  // Cron/admin scan for active + due-to-end tournaments.
  @@index([status])
  @@index([status, endsAt])
}

// One row per winning rank. Written FROZEN in a 'pending' state the
// moment settlement claims a tournament (ended -> settling), then flipped
// to 'paid' by an idempotent, per-row-guarded credit pass. Mirrors the
// WinGo "draw then drain" model: standings are frozen into these rows
// once and never recomputed, so a live leaderboard shift or a settle
// re-run can never change who is paid.
//
// idempotencyKey = tournamentId:userId guarantees a player is credited at
// most once even under concurrent cron ticks; @@unique([tournamentId,
// userId]) enforces one payout per player per tournament, and the second,
// independent @@unique([tournamentId, rank]) guarantees a given rank maps
// to at most one credited row regardless of which user holds it. A crash
// mid-settlement resumes and credits only the still-'pending' rows.
model TournamentPayout {
  id             String   @id @default(cuid())
  tournamentId   String
  userId         String
  rank           Int
  // Frozen final wagered score at settlement time.
  score          Decimal  @db.Decimal(14, 2)
  amount         Decimal  @db.Decimal(14, 2)
  walletTxId     String?
  userBonusId    String?
  // pending (frozen, awaiting credit) -> paid (credited exactly once).
  status         String   @default("pending")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@unique([tournamentId, rank])
  @@index([tournamentId, rank])
}

// Operator-managed social-media link directory rendered in the public
// Footer. Empty / inactive rows are hidden. Falls back to the legacy
// SystemSetting telegram/whatsapp/email contact values when this table
// is empty so a fresh database keeps the existing footer.
model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  label     String
  labelBn   String?
  url       String
  iconUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ---------- VIP Club ----------
//
// Per-user tier ladder for premium players. Admin defines tiers at
// /admin/vip with cashback rate + withdrawal limit overrides; players
// apply via /vip "Apply" button; admin approves/rejects + can promote
// a user directly without an application.
//
// Withdrawal POST checks user.vipTier.withdrawalMaxAmount before the
// global SystemSetting cap so a VIP can withdraw more per request.
// Cashback campaigns can later read vipTier.cashbackRatePercent as a
// per-user override; for the MVP the field is stored but the cashback
// engine still uses the campaign's flat percentage.

model VipTier {
  id                  String        @id @default(cuid())
  name                String        @unique
  nameBn              String?
  position            Int           @default(0)
  description         String?       @db.Text
  descriptionBn       String?       @db.Text
  // Cashback override % (5.00 = 5%). Null = inherit campaign rate.
  cashbackRatePercent Decimal?      @db.Decimal(5, 2)
  // Withdrawal limit override (BDT). Null = use global limit.
  withdrawalMaxAmount Decimal?      @db.Decimal(14, 2)
  // Withdrawal payout priority: higher number = paid first.
  payoutPriority      Int           @default(0)
  // Marketing perks - shown on /vip page as bullet list per tier.
  perksEn             String?       @db.Text
  perksBn             String?       @db.Text
  iconUrl             String?
  badgeColor          String? // hex like "#f5b400"
  status              ContentStatus @default(active)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  users        User[]
  applications VipApplication[]

  @@index([status, position])
}

// One application row per submission. A user can have multiple
// historical rows (e.g. apply, get rejected, apply again later) but
// only one open (status='pending') row at a time - enforced at the
// API layer by checking for an existing pending row before insert.
model VipApplication {
  id         String    @id @default(cuid())
  userId     String
  tierId     String? // Tier the user is requesting (null = any)
  status     String    @default("pending") // pending | approved | rejected | cancelled
  appliedAt  DateTime  @default(now())
  notes      String?   @db.Text // optional player message
  reviewerId String?
  reviewedAt DateTime?
  reviewNote String?   @db.Text // admin's response on approve/reject
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier VipTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

// =====================================================================
// WinGo colour-prediction native game. Additive: two new models plus
// one User back-relation. Follows the native-games conventions used by
// Dice/Mines/Crash: Decimal(14,2) money, Decimal(10,4) multipliers,
// String status fields (not enums), AEAD-encrypted serverSeed with a
// public serverSeedHash for provable fairness, and a unique
// idempotencyKey to make settlement replay-safe. The whole game ships
// DISABLED (gated by the NativeGameProvider `wingo` row + SystemSetting
// flags), so an empty schema never affects any existing flow.
// =====================================================================

// One shared round per (mode, periodNumber). Unlike the per-user
// Dice/Mines rounds, a WinGo round is a public draw that many players
// bet into. Each mode (wingo_30s | wingo_1m | wingo_3m | wingo_5m)
// runs its own back-to-back stream: the next round starts exactly at
// the previous round's drawsAt, deterministic from a fixed epoch
// anchor. Lifecycle by wall clock, enforced server-side:
//   OPEN    startsAt <= now < betCloseAt   (bets accepted)
//   CLOSED  betCloseAt <= now < drawsAt     (betting locked)
//   DRAWN   now >= drawsAt, result generated once
//   SETTLED all bets of the round paid exactly once
// betCloseAt is drawsAt minus 5 seconds. Fairness: serverSeed is
// AEAD-encrypted (lib/crypto/aead.ts) and committed as serverSeedHash
// at round open; the plaintext seed is revealed at settle so anyone
// can replay result = derive(serverSeed, periodNumber) and confirm the
// draw was never rigged. The house edge lives in the paytable, not the
// draw.
model WingoRound {
  id             String    @id @default(cuid())
  // wingo_30s | wingo_1m | wingo_3m | wingo_5m
  mode           String
  // Human-facing id like 20260704100052169: YYYYMMDD + mode tag + a
  // per-mode-per-day running sequence. Unique within a mode.
  periodNumber   String
  // open | closed | drawn | settled. Advanced only by guarded
  // conditional updates (updateMany where status in the pre-draw set)
  // so exactly one caller draws each round under concurrent cron ticks.
  status         String    @default("open")
  startsAt       DateTime
  // drawsAt minus 5 seconds. Server rejects any bet at/after this.
  betCloseAt     DateTime
  drawsAt        DateTime
  // Winning digit 0..9, null until the round is drawn. Generated once
  // at draw time from the revealed serverSeed, never admin-selectable.
  result         Int?
  // Convenience audit fields derived from result at draw time:
  // resultColor is red | green | violet | red_violet | green_violet;
  // resultSize is big (5..9) | small (0..4). Null until drawn.
  resultColor    String?
  resultSize     String?
  // AEAD-encrypted seed blob, committed at open, decrypted at settle.
  serverSeed     String    @db.Text
  // SHA-256 hex of the plaintext seed, public from round open.
  serverSeedHash String
  // Payout multipliers frozen at round open (the same choke point that
  // commits the seed). Settlement reads THIS, never the live setting, so
  // an admin paytable edit can never change what an already-placed bet
  // pays. Null on pre-feature rounds; those fall back to the code default.
  paytable       Json?
  // Running audit aggregates over this round's bets.
  betCount       Int       @default(0)
  totalStake     Decimal   @default(0) @db.Decimal(14, 2)
  totalPayout    Decimal   @default(0) @db.Decimal(14, 2)
  drawnAt        DateTime?
  settledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bets WingoBet[]

  // Round identity: never two rounds with the same period id in a mode.
  @@unique([mode, periodNumber])
  // Per-mode stream lookups (current/next open round, admin filters).
  @@index([mode, status])
  // Cron settle + open scan: rounds of a mode ordered by draw time.
  @@index([mode, drawsAt])
  // Cross-mode "anything past drawsAt still not settled" cron sweep.
  @@index([status, drawsAt])
}

// One bet line per (user, round, selection). A player may place many
// bets in a single round. Each line carries a quantity chip (X1..X100)
// that multiplies the unit stake; betAmount is the total debited
// (unitAmount * quantity) and is enforced <= 100000 BDT server-side
// after the multiplier. The wallet debit at placement and the win
// credit at settle each get their own Transaction row keyed by
// reference = round.id, exactly like the other native games. status
// stays PENDING until the round settles; settlement guards on
// status = PENDING so re-running it can never double-pay.
model WingoBet {
  id               String    @id @default(cuid())
  roundId          String
  userId           String
  // Denormalised from the round so My-history queries filter by mode
  // without joining WingoRound.
  mode             String
  // color | number | size
  betType          String
  // The pick within betType: color -> green | violet | red;
  // number -> "0".."9"; size -> big | small.
  betValue         String
  // Base stake for one chip, before the quantity multiplier.
  unitAmount       Decimal   @db.Decimal(14, 2)
  // X1..X100 chip. betAmount = unitAmount * quantity.
  quantity         Int       @default(1)
  // Total staked = the wallet debit at placement.
  betAmount        Decimal   @db.Decimal(14, 2)
  // Paytable total-return multiplier applied on win, 0 on loss.
  payoutMultiplier Decimal   @default(0) @db.Decimal(10, 4)
  // Gross credit applied on win (betAmount * payoutMultiplier), 0 loss.
  payoutAmount     Decimal   @default(0) @db.Decimal(14, 2)
  // PENDING | WON | LOST | REFUNDED. Settlement flips PENDING -> WON/
  // LOST once; REFUNDED only if a round is voided.
  status           String    @default("PENDING")
  // Blocks a double-debit when a client retries the same placement.
  idempotencyKey   String    @unique
  settledAt        DateTime?
  createdAt        DateTime  @default(now())

  round WingoRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Settlement: pull this round's still-pending bets to pay.
  @@index([roundId, status])
  // All bets of a round (admin round audit view).
  @@index([roundId])
  // Player My-history feed, newest first.
  @@index([userId, createdAt])
  // Tournament leaderboard aggregation: sum stakes over a [start,end) window.
  @@index([createdAt])
}
