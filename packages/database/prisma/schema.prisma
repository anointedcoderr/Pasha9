// Database schema for the Pasha9 platform.
// Live PostgreSQL schema. Migrations live under prisma/migrations.
// Built by Anointed Coder.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  active
  blocked
  pending
}

enum Lang {
  bn
  en
}

enum TxType {
  deposit
  withdraw
  bonus
  referral
  bet
  win
  adjust
}

enum TxStatus {
  pending
  completed
  failed
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum BonusType {
  first_deposit
  daily
  weekly
  referral
  vip
  invite
  reload
  manual
  promo
}

enum ContentStatus {
  active
  hidden
  paused
}

enum GameStatus {
  active
  maintenance
}

enum ProviderStatus {
  active
  maintenance
}

enum TicketStatus {
  open
  pending
  closed
}

enum OtpPurpose {
  signup
  login
  reset
  verify_phone
}

enum SettingCategory {
  general
  branding
  security
  sms
  payment
  apk
  tracking
  content
  referral
}

// ---------- Auth and RBAC ----------

model Role {
  id        String   @id @default(cuid())
  key       String   @unique // super_admin, admin, staff, user
  label     String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  key       String   @unique // banners.write, users.read, etc.
  label     String
  group     String   @default("general") // ui grouping
  createdAt DateTime @default(now())

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// M2G: per-staff additive permission grants. The user's effective
// permission set is union(role.permissions, user.permissions). There
// is no deny flag - if you need to revoke a role-granted permission
// for a specific staff member, move them to a more restricted role
// instead. Created by super_admin / staff.manage holders from the
// /admin/staff page.
model UserPermission {
  userId       String
  permissionId String
  grantedById  String?
  grantedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

model User {
  id                String     @id @default(cuid())
  username          String     @unique
  email             String?    @unique
  phone             String     @unique
  passwordHash      String
  passwordChangedAt DateTime?
  phoneVerifiedAt   DateTime?
  emailVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  roleId            String
  status            UserStatus @default(active)
  // Set whenever status flips to blocked, cleared on unblock. Optional
  // free-text shown to the blocked user on the BlockedAccountBanner.
  blockedReason     String?
  blockedAt         DateTime?
  country           String     @default("BD")
  language          Lang       @default(bn)
  referralCode      String     @unique
  referredById      String?
  isAffiliate       Boolean    @default(false)
  affiliateTierId   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  role       Role   @relation(fields: [roleId], references: [id])
  referredBy User?  @relation("Referrals", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrals")
  affiliateTier        CommissionTier?       @relation(fields: [affiliateTierId], references: [id])

  wallet              Wallet?
  transactions        Transaction[]
  deposits            Deposit[]
  withdrawals         Withdrawal[]
  userBonuses         UserBonus[]
  supportTickets      SupportTicket[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]        @relation("ActorLogs")
  affiliateApplication AffiliateApplication?
  lotteryTickets      LotteryTicket[]
  lotteryWinnings     LotteryWinning[]
  // M2G per-staff permission grants (additive, beyond role baseline).
  extraPermissions    UserPermission[]

  @@index([referredById])
  @@index([roleId])
  @@index([status])
  @@index([isAffiliate])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  ip         String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
}

// ---------- Wallet, transactions, deposits, withdrawals ----------

model Wallet {
  id            String   @id @default(cuid())
  userId        String   @unique
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  bonusBalance  Decimal  @default(0) @db.Decimal(14, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(14, 2)
  // Separate ledger for credited lottery winnings. Kept distinct from
  // main balance so audit and (M2) lotto withdrawal flow stay clean.
  lottoBalance  Decimal  @default(0) @db.Decimal(14, 2)
  currency      String   @default("BDT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        TxType
  amount      Decimal  @db.Decimal(14, 2)
  status      TxStatus @default(completed)
  reference   String?
  description String?
  meta        Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       @db.Decimal(14, 2)
  method        String
  transactionId String
  // Provider reference + key let an automated webhook (M2B+) match an
  // incoming gateway transaction to a pending Deposit row. Null for
  // the original M1 manual flow.
  providerRef   String?
  providerKey   String?
  proofUrl      String?
  status        RequestStatus @default(pending)
  adminNote     String?
  reviewerId    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([providerRef])
}

model Withdrawal {
  id            String        @id @default(cuid())
  userId        String
  amount        Decimal       @db.Decimal(14, 2)
  method        String
  accountNumber String
  accountName   String
  status        RequestStatus @default(pending)
  // M2C: sub-state inside an approved row tracking the payout side.
  // Values: 'on_hold' | 'payout_initiated' | 'paid' (null otherwise).
  processingState String?
  // Outbound payout provider + reference once a real payout gateway
  // is wired. Null for M2 manual payouts.
  providerKey    String?
  providerRef    String?
  paidAt         DateTime?
  adminNote     String?
  reviewerId    String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user   User              @relation(fields: [userId], references: [id])
  events WithdrawalEvent[]

  @@index([status])
  @@index([userId])
  @@index([providerRef])
  @@index([processingState])
}

// Append-only timeline of every state change on a Withdrawal. Lets
// admin + support see exactly who did what when, and lets the user
// dashboard render a "status timeline" without reverse-engineering
// from ActivityLog.
model WithdrawalEvent {
  id           String   @id @default(cuid())
  withdrawalId String
  kind         String   // submitted | reviewed | held | released | approved | payout_initiated | paid | rejected | note
  actorId      String?
  actorRole    String?
  note         String?
  meta         Json?
  createdAt    DateTime @default(now())

  withdrawal Withdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId, createdAt])
  @@index([kind])
}

// ---------- Bonuses ----------

model BonusRule {
  id          String        @id @default(cuid())
  name        String
  type        BonusType
  amount      Decimal       @default(0) @db.Decimal(14, 2)
  percentage  Decimal       @default(0) @db.Decimal(5, 2)
  minDeposit  Decimal       @default(0) @db.Decimal(14, 2)
  maxBonus    Decimal       @default(0) @db.Decimal(14, 2)
  status      ContentStatus @default(active)
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  turnoverX   Decimal       @default(0) @db.Decimal(6, 2)
  // M2D: optional stable lookup key so engine code can trigger a
  // rule (e.g. 'welcome', 'deposit_match', 'reload_weekend') without
  // depending on a row id. Unique when set.
  code         String?      @unique
  // Bonus expires N days after grant. 0 = never expires.
  validityDays Int          @default(30)
  // Higher priority rules win when multiple rules of the same trigger
  // type are eligible for the same deposit.
  priority     Int          @default(0)
  // Free-form rule config (e.g. weekday filter, vip tier required).
  meta         Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userBonuses UserBonus[]
}

model UserBonus {
  id          String    @id @default(cuid())
  userId      String
  bonusRuleId String
  amount      Decimal   @db.Decimal(14, 2)
  claimedAt   DateTime  @default(now())
  expiresAt   DateTime?
  // M2D: lifecycle. active = wagering in progress (locked), completed
  // = turnover satisfied + funds released, expired = past expiresAt
  // and forfeited, cancelled = admin cancel.
  status           String   @default("active")
  // Wager requirement = amount * BonusRule.turnoverX. Locked until
  // progress catches up.
  turnoverRequired Decimal  @default(0) @db.Decimal(14, 2)
  turnoverProgress Decimal  @default(0) @db.Decimal(14, 2)
  releasedAt       DateTime?
  cancelledAt      DateTime?
  // Where the grant came from. Lets admin trace a granted bonus back
  // to its trigger (deposit row, manual admin action, referral, etc).
  sourceType       String?
  sourceId         String?
  note             String?

  user           User             @relation(fields: [userId], references: [id])
  bonusRule      BonusRule        @relation(fields: [bonusRuleId], references: [id])
  turnoverEvents TurnoverEvent[]

  @@index([userId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// M2D: per-event ledger of wager activity that contributed turnover
// to a specific UserBonus grant. Lets the dashboard show the user
// where their progress came from and lets admins audit a grant.
model TurnoverEvent {
  id           String   @id @default(cuid())
  userId       String
  bonusGrantId String?
  amount       Decimal  @db.Decimal(14, 2)
  kind         String   // bet|win|adjust|manual
  reference    String?
  meta         Json?
  createdAt    DateTime @default(now())

  bonusGrant UserBonus? @relation(fields: [bonusGrantId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([bonusGrantId])
}

// ---------- Editable content (CMS) ----------

model Banner {
  id         String        @id @default(cuid())
  title      String
  subtitle   String?
  titleEn    String?
  subtitleEn String?
  // Media type controls how the public slider renders the slide.
  // "image" (default) renders <img> from imageUrl.
  // "video" renders an autoplay-muted <video> from videoUrl with posterUrl
  // as the still fallback while loading / when autoplay is blocked.
  mediaType  String        @default("image")
  imageUrl   String?
  videoUrl   String?
  posterUrl  String?
  link       String?
  ctaLabel   String?
  accent     String        @default("gold")
  position   Int           @default(0)
  status     ContentStatus @default(active)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, position])
}

model PopupAnnouncement {
  id        String        @id @default(cuid())
  title     String
  body      String        @db.Text
  ctaLabel  String?
  ctaHref   String?
  startAt   DateTime?
  endAt     DateTime?
  status    ContentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model PromoText {
  id        String        @id @default(cuid())
  message   String
  position  Int           @default(0)
  status    ContentStatus @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, position])
}

model HomepageContent {
  id        String   @id @default(cuid())
  section   String   @unique // hero, about, jackpot, footer, hero_secondary, etc.
  titleBn   String?
  titleEn   String?
  bodyBn    String?  @db.Text
  bodyEn    String?  @db.Text
  imageUrl  String?
  link      String?
  meta      Json?
  updatedAt DateTime @updatedAt
}

// ---------- Games ----------

model GameCategory {
  id           String        @id @default(cuid())
  slug         String        @unique
  nameBn       String
  nameEn       String
  iconKey      String
  // Optional uploaded image used as the category icon. When set the
  // public site prefers this over iconKey, falling back to iconKey if
  // the image fails to load.
  iconImageUrl String?
  position     Int           @default(0)
  status       ContentStatus @default(active)
  games        Game[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model GameProvider {
  id        String         @id @default(cuid())
  name      String         @unique
  apiBase   String?
  apiKey    String?
  status    ProviderStatus @default(active)
  games     Game[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Game {
  id            String     @id @default(cuid())
  name          String
  nameBn        String?
  categoryId    String
  providerId    String
  imageUrl      String?
  launchUrl     String?
  accent        String     @default("gold")
  isFeatured    Boolean    @default(false)
  status        GameStatus @default(active)
  minBet        Decimal    @default(10) @db.Decimal(14, 2)
  maxBet        Decimal    @default(5000) @db.Decimal(14, 2)
  houseEdge     Decimal    @default(3) @db.Decimal(5, 2)
  rtpTarget     Decimal    @default(95) @db.Decimal(5, 2)
  riskLevel     String     @default("medium")
  wagerContrib  Decimal    @default(100) @db.Decimal(5, 2)
  bonusEligible Boolean    @default(true)
  payoutTable   Json?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  category GameCategory @relation(fields: [categoryId], references: [id])
  provider GameProvider @relation(fields: [providerId], references: [id])

  @@index([categoryId])
  @@index([providerId])
  @@index([status])
}

// ---------- Referrals ----------
//
// Referral relationships are tracked on the User row via referredById.
// This standalone table is reserved for explicit multi-level snapshots in M2.

model ReferralLink {
  id             String        @id @default(cuid())
  referrerId     String
  referredUserId String
  level          Int           @default(1)
  status         ContentStatus @default(active)
  createdAt      DateTime      @default(now())

  @@unique([referrerId, referredUserId])
  @@index([referrerId])
}

model ReferralBonus {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String
  amount      Decimal  @db.Decimal(14, 2)
  level       Int      @default(1)
  description String?
  createdAt   DateTime @default(now())

  @@index([referrerId])
}

// ---------- Affiliate program (Phase 4) ----------

model AffiliateApplication {
  id          String    @id @default(cuid())
  userId      String    @unique
  status      String    @default("pending") // pending, approved, rejected
  channel     String?
  audience    String?
  notes       String?
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CommissionTier {
  id                 String        @id @default(cuid())
  name               String        @unique
  description        String?
  level1Pct          Decimal       @db.Decimal(5, 2)
  level2Pct          Decimal       @db.Decimal(5, 2)
  level3Pct          Decimal       @db.Decimal(5, 2)
  minActiveReferrals Int           @default(0)
  minMonthlyVolume   Decimal       @default(0) @db.Decimal(14, 2)
  status             ContentStatus @default(active)
  position           Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  users              User[]
}

model AffiliateCommission {
  id           String   @id @default(cuid())
  affiliateId  String
  sourceUserId String
  level        Int
  amount       Decimal  @db.Decimal(14, 2)
  basis        String   // deposit_share, signup_bonus, manual
  status       String   @default("pending") // pending, approved, paid, cancelled
  meta         Json?
  createdAt    DateTime @default(now())
  // M2E additions: trace each commission back to the deposit that
  // triggered it (null for manual / signup grants), the tier and
  // rate used at accrual time so historical reports stay correct
  // even after an admin rebalances the tier rates, and a link to
  // the payout that settled it.
  depositId    String?
  tierId       String?
  ratePct      Decimal? @db.Decimal(5, 2)
  payoutId     String?

  payout       CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
  @@index([depositId])
  @@index([payoutId])
}

// M2E: an affiliate's request to cash out approved commissions.
// Lifecycle: pending -> approved (admin confirmed, payout in flight)
// -> paid (manual or automated payout cleared) | rejected (admin
// declined with note). On approve, the engine flips every linked
// AffiliateCommission to status=paid and stamps payoutId so the
// commission rows cannot be double-spent into another request.
model CommissionPayout {
  id            String   @id @default(cuid())
  affiliateId   String
  amount        Decimal  @db.Decimal(14, 2)
  method        String   // bkash | nagad | rocket | bank
  accountNumber String
  accountName   String
  status        String   @default("pending") // pending | approved | rejected | paid
  adminNote     String?
  reviewerId    String?
  reviewedAt    DateTime?
  paidAt        DateTime?
  providerKey   String?  // future payout-provider auto-pay reference
  providerRef   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  commissions AffiliateCommission[]

  @@index([affiliateId])
  @@index([status])
  @@index([createdAt])
}

// ---------- Lotto draws and reward catalog (Phase 5) ----------

model LottoDraw {
  id          String        @id @default(cuid())
  name        String
  schedule    String?       // human readable: "Daily 19:30", "Friday 22:30"
  drawsAt     DateTime?     // next draw timestamp
  digitsCount Int           @default(4)
  ticketPrice Decimal       @default(20) @db.Decimal(14, 2)
  prizePool   Decimal       @default(0)  @db.Decimal(14, 2)
  accent      String        @default("yellow") // yellow, blue, red, royal
  position    Int           @default(0)
  status      ContentStatus @default(active)
  // M2F: lifecycle markers for the rollover cron. closedAt is set
  // when ticket sales are frozen for this draw (typically the moment
  // the rollover fires - 7:30 PM cutoff). settledAt is set when the
  // result row is published. Both null = still accepting tickets.
  closedAt    DateTime?
  settledAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tickets     LotteryTicket[]
  result      LotteryDrawResult?

  @@index([status, position])
}

// Reconciliation log for incoming payment gateway events (M2B). Every
// webhook hit lands here even if the signature is invalid or no
// matching Deposit exists, so support can investigate after the fact.
// Status moves: initiated -> verified -> credited (success) OR
// failed / duplicate / unmatched / signature_invalid.
model PaymentGatewayTx {
  id              String   @id @default(cuid())
  provider        String   // manual | test | bkash | nagad | rocket | ...
  // M2C: distinguishes incoming deposit verification (inbound) from
  // outgoing payout status callbacks (outbound). Defaults to inbound
  // so existing M2B rows do not change meaning.
  direction       String   @default("inbound") // inbound | outbound
  providerTxId    String?
  depositId       String?
  withdrawalId    String?
  userId          String?
  amount          Decimal? @db.Decimal(14, 2)
  currency        String   @default("BDT")
  status          String   @default("initiated")
  signatureValid  Boolean  @default(false)
  raw             Json?
  note            String?
  meta            Json?
  receivedAt      DateTime @default(now())
  processedAt     DateTime?

  @@index([provider, providerTxId])
  @@index([depositId])
  @@index([withdrawalId])
  @@index([userId])
  @@index([status])
  @@index([direction, status])
  @@index([receivedAt])
}

// 4D lottery ticket. Generated automatically when admin approves a
// deposit ("source=deposit_accrual") - every accumulated BDT 1,200 of
// approved deposits earns the user 2 tickets. Manual purchase is not
// supported in M1.
model LotteryTicket {
  id              String   @id @default(cuid())
  userId          String
  drawId          String?
  number          String   // 4 digits, e.g. "1234"
  source          String   @default("deposit_accrual") // deposit_accrual | admin_grant
  sourceDepositId String?
  status          String   @default("issued") // issued | won | lost | void
  generatedAt     DateTime @default(now())

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  draw            LottoDraw? @relation(fields: [drawId], references: [id])

  @@index([userId])
  @@index([drawId])
  @@index([userId, generatedAt])
}

// Settlement record published by admin per draw. Holds the winning
// number and the prize multipliers applied to that draw. Created
// exactly once per LottoDraw (1:1).
model LotteryDrawResult {
  id              String   @id @default(cuid())
  drawId          String   @unique
  winningNumber   String   // 4 digits, e.g. "1234" or "1111"
  ticketBaseValue Decimal  @default(20) @db.Decimal(14, 2)
  // Prize multipliers per the published structure. Stored on the
  // result so historical draws stay correct even if the live structure
  // changes later.
  prize1xMult       Decimal @default(2000) @db.Decimal(8, 2)
  prize2xMult       Decimal @default(800)  @db.Decimal(8, 2)
  prize3xMult       Decimal @default(300)  @db.Decimal(8, 2)
  prizeSpecialMult  Decimal @default(150)  @db.Decimal(8, 2)
  prizeConsoMult    Decimal @default(30)   @db.Decimal(8, 2)
  publishedById     String?
  publishedAt       DateTime @default(now())
  // Quick aggregates so the public results card is cheap to render.
  totalWinners      Int       @default(0)
  totalPaid         Decimal   @default(0) @db.Decimal(14, 2)

  draw      LottoDraw         @relation(fields: [drawId], references: [id])
  winnings  LotteryWinning[]
}

// Per-ticket winning record. Created during settlement for every
// ticket that matched a prize tier. status moves from pending_credit
// to credited when the user's Wallet.lottoBalance is bumped.
// M2F: prizeTier values expanded to first_exact | first_ibox |
// second | third | special | consolation. Each ticket gets at most
// ONE winning row (highest-paying tier wins).
model LotteryWinning {
  id           String   @id @default(cuid())
  userId       String
  resultId     String
  ticketId     String?
  ticketNumber String
  prizeTier    String   // first_exact | first_ibox | second | third | special | consolation
  amount       Decimal  @db.Decimal(14, 2)
  status       String   @default("credited") // pending_credit | credited | cancelled
  createdAt    DateTime @default(now())
  creditedAt   DateTime?

  user   User              @relation(fields: [userId], references: [id])
  result LotteryDrawResult @relation(fields: [resultId], references: [id])

  @@index([userId])
  @@index([resultId])
  @@index([prizeTier])
}

model RewardItem {
  id          String        @id @default(cuid())
  title       String
  description String?
  cost        Int           @default(1000) // coin cost
  category    String        @default("misc") // recharge, spin, bet, physical, misc
  accent      String        @default("yellow") // yellow, blue, red, green
  position    Int           @default(0)
  status      ContentStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, position])
}

// ---------- Audit and system ----------

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String? // snapshot of role.key at action time
  action    String
  target    String?
  detail    String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String?
  subject   String
  body      String       @db.Text
  status    TicketStatus @default(open)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
}

model SystemSetting {
  id        String          @id @default(cuid())
  key       String          @unique
  value     String          @db.Text
  type      String          @default("string") // string, number, boolean, json
  category  SettingCategory @default(general)
  updatedAt DateTime        @updatedAt
}

model PaymentMethod {
  id          String        @id @default(cuid())
  name        String        @unique
  type        String        @default("mobile") // mobile, bank, crypto
  status      ContentStatus @default(active)
  number      String
  instruction String        @db.Text
  position    Int           @default(0)
  // M2C: per-method enable flags + amount caps. depositEnabled keeps
  // backwards compatibility (existing rows treated as deposit-enabled);
  // payoutEnabled defaults to false so a method must be explicitly
  // allowed for withdrawals.
  depositEnabled  Boolean  @default(true)
  payoutEnabled   Boolean  @default(false)
  minDeposit      Decimal? @db.Decimal(14, 2)
  maxDeposit      Decimal? @db.Decimal(14, 2)
  minWithdrawal   Decimal? @db.Decimal(14, 2)
  maxWithdrawal   Decimal? @db.Decimal(14, 2)
  payoutInstruction String? @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, position])
}
